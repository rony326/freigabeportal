<% /* Haken am rechten Feldrand für einen KI-Wert (services/kiBestaetigung.js); steht in einer .input-group direkt nach dem
     Eingabefeld. Parameter: feld (rechnungsnummer|zahlungsziel|betrag), bestaetigt (Hakenstatus aus dem letzten Absenden), praefix (optional,
     Vorsatz der id, wenn dasselbe Feld ein zweites Mal auf der Seite steht: Aufsplitten-Assistent «split-»).
     Ohne JS ist es eine normale Checkbox (Bootstrap .btn-check); mit JS (kontierung-ki.js) setzt eine Änderung des Werts den
     Haken selbst und die rote Markierung verschwindet. */ -%>
<input type="checkbox" class="btn-check" id="<%= locals.praefix || '' %>bestaetigt-<%= feld %>" name="bestaetigt_<%= feld %>" value="1" autocomplete="off" data-ki-haken="<%= feld %>"<%= bestaetigt ? " checked" : "" %>>
<label class="btn btn-outline-success ki-haken" for="<%= locals.praefix || '' %>bestaetigt-<%= feld %>" title="Geprüft – Wert bestätigen"><%- include("_symbol", { name: "check-lg" }) %><span class="visually-hidden">Automatisch erkannten Wert bestätigen</span></label>