<!DOCTYPE html>
<html lang="de"<% if (branding.themeAttr) { %> data-theme="<%= branding.themeAttr %>" data-bs-theme="<%= branding.bsThemeAttr %>"<% } %>>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="/vendor/bootstrap/bootstrap.min.css">
  <title>Kontierung — <%= branding.seitenTitel %></title>
</head>
<body>
  <%- include('_header') %>
  <main class="container-fluid py-4">
    <div class="row g-3 justify-content-center">
      <div class="col-lg-12 col-xl-10">
        <h1 class="h3">Kontierung: <%= job.dateiname %></h1>
        <p class="text-muted">Vorgangsnummer: <%= job.id %> · Quelle: <%= job.quelle === 'scanner' ? 'Scanner' : 'Lieferant' %></p>
      </div>
      <div class="w-100"></div>
      <div class="col-lg-6">
        <div class="d-flex justify-content-end mb-1">
          <button type="button" id="preview-refresh-btn" class="btn btn-outline-secondary btn-sm">Vorschau neu laden</button>
        </div>
        <iframe id="kontierung-preview-frame" data-preview-url="<%= previewUrl %>" src="" class="w-100 rounded pdf-preview" style="height:85vh"></iframe>
      </div>
      <div class="col-lg-6 col-xl-4">
        <div class="card">
          <div class="card-body">
            <% if (errors.length > 0) { %>
              <div class="alert alert-danger">
                <ul class="mb-0"><% errors.forEach((error) => { %><li><%= error %></li><% }) %></ul>
              </div>
            <% } %>

            <form id="kontierung-form" method="post" action="/kontierung/<%= job.id %>">
              <div class="mb-3">
                <label class="form-label" for="kontoId">Konto</label>
                <select class="form-select" id="kontoId" name="kontoId" required>
                  <option value="">— wählen —</option>
                  <% konten.forEach((k) => { %>
                    <option value="<%= k.id %>" <%= String(k.id) === values.kontoId ? 'selected' : '' %>><%= k.kontonummer %> — <%= k.bezeichnung %></option>
                  <% }) %>
                </select>
              </div>

              <div class="row g-2 mb-3">
                <div class="col-6">
                  <label class="form-label" for="absender">Absender</label>
                  <input type="text" class="form-control" id="absender" name="absender" value="<%= values.absender || '' %>">
                </div>
                <div class="col-6">
                  <label class="form-label" for="debitorId">Lieferant</label>
                  <select class="form-select" id="debitorId" name="debitorId">
                    <option value="">— wählen —</option>
                    <% debitoren.forEach((d) => { %>
                      <option value="<%= d.id %>" <%= String(d.id) === values.debitorId ? 'selected' : '' %>><%= d.name %></option>
                    <% }) %>
                  </select>
                </div>
              </div>

              <div class="mb-3">
                <label class="form-label" for="rechnungsnummer">Rechnungsnummer</label>
                <input type="text" class="form-control" id="rechnungsnummer" name="rechnungsnummer" value="<%= values.rechnungsnummer || '' %>">
              </div>

              <div class="row g-2 mb-3">
                <div class="col-6">
                  <label class="form-label" for="betrag">Betrag</label>
                  <input type="text" inputmode="decimal" class="form-control" id="betrag" name="betrag" value="<%= values.betrag || '' %>" placeholder="z.B. 123.45">
                </div>
                <div class="col-6">
                  <label class="form-label" for="zahlungsziel">Zahlungsziel</label>
                  <input type="date" class="form-control" id="zahlungsziel" name="zahlungsziel" value="<%= values.zahlungsziel || '' %>">
                </div>
              </div>

              <div class="mb-3">
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="interessenskonflikt" id="konfliktNein" value="nein" <%= values.interessenskonflikt !== 'ja' ? 'checked' : '' %>>
                  <label class="form-check-label" for="konfliktNein">Kein Interessenskonflikt</label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="interessenskonflikt" id="konfliktJa" value="ja" <%= values.interessenskonflikt === 'ja' ? 'checked' : '' %>>
                  <label class="form-check-label" for="konfliktJa">Interessenskonflikt</label>
                </div>
              </div>

              <div class="mb-3">
                <label class="form-label" for="begruendung">Begründung <span class="text-muted">(bei Interessenskonflikt oder Ablehnung Pflicht)</span></label>
                <textarea class="form-control" id="begruendung" name="begruendung"><%= values.begruendung || '' %></textarea>
              </div>

            </form>
            <form id="zurueck-in-pool-form" method="post" action="/kontierung/<%= job.id %>/zurueck-in-pool"></form>

            <div class="d-flex flex-wrap gap-2">
              <button type="submit" form="kontierung-form" name="aktion" value="kontieren" class="btn btn-primary btn-sm">Kontieren</button>
              <button type="submit" form="kontierung-form" name="aktion" value="ablehnen" id="ablehnen-btn" class="btn btn-outline-danger btn-sm">Ablehnen</button>
              <button type="submit" form="zurueck-in-pool-form" class="btn btn-outline-secondary btn-sm">Zurück in den Pool legen</button>
              <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#aufsplitten-modal">Rechnung aufsplitten</button>
            </div>
          </div>
        </div>
        <%- include('_audit_log') %>
      </div>
    </div>

    <div class="modal fade" id="aufsplitten-modal" tabindex="-1" aria-labelledby="aufsplitten-modal-label" aria-hidden="true">
      <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="aufsplitten-modal-label">Rechnung aufsplitten</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schließen"></button>
          </div>
          <div class="modal-body p-0">
            <iframe id="aufsplitten-frame" title="Rechnung aufsplitten" style="width:100%;height:70vh;border:0"></iframe>
          </div>
        </div>
      </div>
    </div>
  </main>
  <script>
    // See pool.ejs's thumbnail-click handler for why file= must be resolved to an absolute URL.
    (function () {
      var frame = document.getElementById('kontierung-preview-frame');
      function ladeVorschau() {
        var absoluteUrl = new URL(frame.dataset.previewUrl, window.location.origin).href;
        frame.src = '/vendor/pdfjs/web/viewer.html?file=' + encodeURIComponent(absoluteUrl);
      }
      ladeVorschau();
      // Signed preview links are short-lived (see PDF_PREVIEW_TTL_SECONDS) — if this page has
      // been open longer than that, the embedded PDF stops loading with no obvious way to
      // recover short of a full reload. This button re-authorizes the session and mints a fresh
      // link instead.
      document.getElementById('preview-refresh-btn').addEventListener('click', function () {
        fetch('/downloads/<%= job.id %>/refresh-url')
          .then(function (res) { return res.ok ? res.json() : Promise.reject(); })
          .then(function (data) {
            frame.dataset.previewUrl = data.url;
            ladeVorschau();
          })
          .catch(function () {
            alert('Vorschau konnte nicht neu geladen werden.');
          });
      });
    })();
    // Ablehnen deliberately needs no Konto (the server-side handler skips that check for
    // aktion=ablehnen) — but the Konto <select>'s HTML `required` attribute is enforced by the
    // browser before the form is even submitted, regardless of which button triggered it. Drop
    // it the moment Ablehnen is clicked so the browser lets an empty Konto through; a fresh page
    // load (any validation error re-renders the page) restores the attribute from the template.
    document.getElementById('ablehnen-btn').addEventListener('click', function () {
      document.getElementById('kontoId').required = false;
    });
    // "Rechnung aufsplitten" opens the existing standalone split page inside a Bootstrap modal via
    // an <iframe>, rather than navigating away — the page itself is unchanged (still a normal
    // GET/POST form) so error re-renders just update in place inside the modal. Two things need
    // JS glue because the split route was written for full-page navigation, not an iframe: (1) the
    // frame is only pointed at the route once the modal is actually opened, so it isn't fetched on
    // every Kontierung page load; (2) a successful split redirects to /pool server-side, which
    // would otherwise load /pool squeezed inside the small iframe — the load handler below detects
    // that and breaks the redirect out to the top-level window instead.
    (function () {
      var modal = document.getElementById('aufsplitten-modal');
      var frame = document.getElementById('aufsplitten-frame');
      var frameUrl = '/kontierung/<%= job.id %>/aufsplitten';
      var geladen = false;
      modal.addEventListener('shown.bs.modal', function () {
        if (!geladen) {
          geladen = true;
          frame.src = frameUrl;
        }
      });
      frame.addEventListener('load', function () {
        try {
          if (frame.contentWindow.location.pathname === '/pool') {
            window.location.href = '/pool';
          }
        } catch (e) {
          // Same-origin by construction; nothing to do if the browser disagrees.
        }
      });
      // The split page's "Abbrechen" link can't close a modal in the parent document directly
      // (different document) — it posts a message instead, handled here.
      window.addEventListener('message', function (e) {
        if (e.origin === window.location.origin && e.data === 'aufsplitten-abbrechen') {
          bootstrap.Modal.getOrCreateInstance(modal).hide();
        }
      });
    })();
  </script>
  <%- include('_footer') %>
</body>
</html>
