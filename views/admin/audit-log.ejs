<%- include('../_seite_anfang', { titel: 'Audit-Log' }) %>
    <div class="seitenkopf">
      <h1 class="seitenkopf-titel">Globales Audit-Log</h1>
    </div>
    <% const hw = historie.werte; %>
    <% if (aenderungen.length || historie.gefiltert) { %>
    <h2 class="h5">Änderungshistorie</h2>
    <form method="get" class="filterzeile" aria-label="Änderungshistorie filtern">
      <div class="col-auto">
        <label class="form-label small mb-1" for="h_objekt">Objekt</label>
        <select class="form-select" id="h_objekt" name="h_objekt">
          <option value="">Alle Objekte</option>
          <% historie.objekte.forEach((o) => { %>
            <option value="<%= o %>" <%= hw.h_objekt === o ? 'selected' : '' %>><%= objektLabel(o) %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-auto">
        <label class="form-label small mb-1" for="h_lauf">Hintergrundlauf</label>
        <select class="form-select" id="h_lauf" name="h_lauf">
          <option value="">Alle Läufe</option>
          <% historie.laeufe.forEach((l) => { %>
            <option value="<%= l %>" <%= hw.h_lauf === l ? 'selected' : '' %>><%= l %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-auto">
        <label class="form-label small mb-1" for="h_aktion">Aktion</label>
        <select class="form-select" id="h_aktion" name="h_aktion">
          <option value="">Alle Aktionen</option>
          <% historie.aktionen.forEach((a) => { %>
            <option value="<%= a %>" <%= hw.h_aktion === a ? 'selected' : '' %>><%= a %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-auto">
        <label class="form-label small mb-1" for="h_person">Person</label>
        <input type="text" class="form-control" id="h_person" name="h_person" value="<%= hw.h_person || '' %>" placeholder="Name oder ID">
      </div>
      <div class="col-auto">
        <label class="form-label small mb-1" for="h_von">Von</label>
        <input type="date" class="form-control" id="h_von" name="h_von" value="<%= hw.h_von || '' %>">
      </div>
      <div class="col-auto">
        <label class="form-label small mb-1" for="h_bis">Bis</label>
        <input type="date" class="form-control" id="h_bis" name="h_bis" value="<%= hw.h_bis || '' %>">
      </div>
      <div class="col-auto">
        <label class="form-label small mb-1" for="h_q">Suche</label>
        <input type="text" class="form-control" id="h_q" name="h_q" value="<%= hw.h_q || '' %>" placeholder="ID, Inhalt, Request, Lauf">
      </div>
      <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Filtern</button>
        <% if (historie.gefiltert) { %><a class="btn btn-link" href="/admin/audit-log">Zurücksetzen</a><% } %>
      </div>
    </form>
    <% if (!aenderungen.length) { %>
      <p>Keine Änderungen gefunden.</p>
    <% } else { %>
    <div class="table-responsive">
      <table class="table">
        <thead><tr><th>Zeitpunkt</th><th>Person</th><th>Objekt</th><th>Aktion</th><th>Änderung</th></tr></thead>
        <tbody>
          <% aenderungen.forEach((e) => { %>
            <tr><td><%= e.zeitpunkt %></td><td><%= e.person_name %> (<%= e.person_id %>)</td>
              <td><%= objektLabel(e.objekt) %> #<%= e.objekt_id %></td><td><%= e.aktion %></td>
              <td><details><summary>Details</summary><p><%= e.begruendung || '' %></p>
                <% if (e.request_id) { %><p>Request-ID: <code><%= e.request_id %></code></p><% } %>
                <% if (e.lauf_id) { %><p>Lauf: <%= e.lauf_typ %> <code><%= e.lauf_id %></code></p><% } %>
                <pre style="white-space:pre-wrap;overflow-wrap:anywhere"><%= e.vorher || '' %></pre>
                <pre style="white-space:pre-wrap;overflow-wrap:anywhere"><%= e.nachher || '' %></pre>
              </details></td></tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
    <p><a href="/admin/audit-log<%= historie.gefiltert ? '?' + new URLSearchParams(hw).toString() : '' %>">Neueste Änderungen</a>
      <% if (historie.naechsteSeite && aenderungen.length) { %> · <a href="?<%= historie.naechsteSeite %>">Ältere Änderungen</a><% } %>
    </p>
    <% } %>
    <h2 class="h5">Freigaben und Löschungen</h2>

    <form method="get" class="filterzeile">
      <div class="col-auto">
        <select class="form-select" name="person">
          <option value="">Alle Personen</option>
          <% personen.forEach((p) => { %>
            <option value="<%= p.churchtools_person_id %>" <%= query.person === p.churchtools_person_id ? 'selected' : '' %>><%= p.vorname %> <%= p.nachname %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-auto">
        <select class="form-select" name="konto">
          <option value="">Alle Konten</option>
          <% konten.forEach((k) => { %>
            <option value="<%= k.id %>" <%= String(query.konto) === String(k.id) ? 'selected' : '' %>><%= k.kontonummer %> — <%= k.bezeichnung %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-auto">
        <select class="form-select" name="typ">
          <option value="">Alle Ereignisse</option>
          <% Object.keys(ereignisLabels).forEach((typ) => { %>
            <option value="<%= typ %>" <%= query.typ === typ ? 'selected' : '' %>><%= ereignisLabels[typ] %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-auto">
        <input type="date" class="form-control" name="von" value="<%= query.von || '' %>" placeholder="Von">
      </div>
      <div class="col-auto">
        <input type="date" class="form-control" name="bis" value="<%= query.bis || '' %>" placeholder="Bis">
      </div>
      <div class="col-auto">
        <input type="text" class="form-control" name="q" value="<%= query.q || '' %>" placeholder="Suche in Kommentar/Dateiname">
      </div>
      <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Filtern</button>
      </div>
    </form>

    <% if (eintraege.length === 0) { %>
      <p>Keine Einträge gefunden.</p>
    <% } else { %>
      <p><%= gesamtAnzahl %> Einträge</p>
      <div class="table-responsive">
        <table class="table align-middle">
          <thead><tr><th>Zeitpunkt</th><th>Ereignis</th><th>Person</th><th>Job</th><th>Konto</th><th>Kommentar/Begründung</th></tr></thead>
          <tbody>
            <% eintraege.forEach((eintrag) => { %>
              <tr>
                <td><%= eintrag.zeitpunkt %></td>
                <td><%= eintrag.ereignis %></td>
                <td><%= eintrag.person %></td>
                <td><%= eintrag.dateiname %> (#<%= eintrag.jobId %>)</td>
                <td><%= eintrag.kontoBezeichnung || '—' %></td>
                <td><%= eintrag.kommentar || '' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <nav aria-label="Seiten">
        <ul class="pagination">
          <li class="page-item <%= seite <= 1 ? 'disabled' : '' %>">
            <% if (seite <= 1) { %>
              <span class="page-link">Zurück</span>
            <% } else { %>
              <a class="page-link" href="?<%= new URLSearchParams({ ...query, seite: seite - 1 }).toString() %>">Zurück</a>
            <% } %>
          </li>
          <li class="page-item disabled"><span class="page-link">Seite <%= seite %> von <%= gesamtSeiten %></span></li>
          <li class="page-item <%= seite >= gesamtSeiten ? 'disabled' : '' %>">
            <% if (seite >= gesamtSeiten) { %>
              <span class="page-link">Weiter</span>
            <% } else { %>
              <a class="page-link" href="?<%= new URLSearchParams({ ...query, seite: seite + 1 }).toString() %>">Weiter</a>
            <% } %>
          </li>
        </ul>
      </nav>
    <% } %>
<%- include('../_seite_ende') %>
