{
  "name": "freigabeportal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "backup:verify": "node --env-file-if-exists=.env src/cli/backupRestore.js verify",
    "backup:restore": "node --env-file-if-exists=.env src/cli/backupRestore.js restore",
    "backup:rollback": "node --env-file-if-exists=.env src/cli/backupRestore.js rollback",
    "backup:status": "node --env-file-if-exists=.env src/cli/backupRestore.js status",
    "test": "node --test 'test/**/*.test.js'"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "asn1js": "3.0.10",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^4.0.3",
    "ejs": "^3.1.10",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.18.0",
    "jsqr": "^1.4.0",
    "multer": "^2.2.0",
    "mupdf": "^1.28.0",
    "nodemailer": "^9.0.5",
    "pdf-lib": "^1.17.1",
    "pdf-rfc3161": "^0.1.4",
    "pkijs": "3.4.0"
  },
  "devDependencies": {
    "pdfkit": "^0.19.1",
    "supertest": "^7.0.0",
    "swissqrbill": "^4.4.1",
    "undici": "^6.19.0"
  }
}
