<!DOCTYPE html>
<html lang="de"<% if (branding.themeAttr) { %> data-theme="<%= branding.themeAttr %>" data-bs-theme="<%= branding.bsThemeAttr %>"<% } %>>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="/vendor/bootstrap/bootstrap.min.css">
  <title>Abgelehnte Rechnungen — Freigabeportal Admin</title>
</head>
<body>
  <%- include('../_header') %>
  <main class="container py-4">
    <%- include('./_nav') %>
    <h1>Abgelehnte Rechnungen</h1>
    <% if (gespeichert) { %>
      <div class="alert alert-success alert-dismissible fade show" role="alert">
        Gelöscht.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Schließen"></button>
      </div>
    <% } %>
    <% if (jobs.length === 0) { %>
      <p>Keine abgelehnten Rechnungen.</p>
    <% } else { %>
      <div class="table-responsive">
        <table class="table align-middle">
          <thead><tr><th>Dateiname</th><th>Lieferant</th><th>Grund</th><th>Abgelehnt von</th><th>Eingang</th><th></th></tr></thead>
          <tbody>
            <% jobs.forEach((job) => { %>
              <tr>
                <td><%= job.dateiname %></td>
                <td><%= job.lieferant || '—' %></td>
                <td><%= job.ablehnungsgrund %></td>
                <td><%= job.abgelehntVonPerson ? `${job.abgelehntVonPerson.vorname} ${job.abgelehntVonPerson.nachname}` : 'Unbekannt' %></td>
                <td><%= job.eingang_am %></td>
                <td><a href="/admin/abgelehnt/<%= job.id %>" class="btn btn-outline-danger btn-sm">Löschen</a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </main>
  <%- include('../_footer') %>
</body>
</html>
