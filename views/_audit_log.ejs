<% if (typeof auditLog !== 'undefined' && auditLog.length > 0) { %>
  <div class="card mt-3">
    <div class="card-body">
      <h2 class="h6">Audit-Log</h2>
      <ul class="list-group list-group-flush">
        <% auditLog.forEach((eintrag) => { %>
          <li class="list-group-item">
            <div>
              <strong><%= eintrag.ereignis %></strong> — <%= eintrag.person %><% if (eintrag.eskaliertVonPerson) { %> (eskaliert von <%= eintrag.eskaliertVonPerson %>)<% } %>
            </div>
            <div class="text-muted small"><%= eintrag.zeitpunkt %><% if (eintrag.interessenskonflikt) { %> · Interessenskonflikt<% } %></div>
            <% if (eintrag.kommentar) { %><div class="small">„<%= eintrag.kommentar %>“</div><% } %>
          </li>
        <% }) %>
      </ul>
    </div>
  </div>
<% } %>
