# Durchlauf-Test (docs/durchlauf-test.md) – Vorlage.
# Kopieren nach .env.durchlauf (git-ignoriert) und ausfüllen:  cp .env.durchlauf.example .env.durchlauf
# NIE die Adresse des Live-Portals eintragen. Der Durchlauf kontiert und gibt Belege wirklich frei.

# Pflicht: Adresse der TESTINSTANZ (nur https://; http:// nur für localhost). Kein Standardwert.
DURCHLAUF_ZIEL_URL=https://test-portal.example.org

# Pflicht: Kontonummer des Testkontos (Freigeber 1 = Person A, Freigeber 2 = Person B).
DURCHLAUF_KONTO=9999

# Anzahl Belege, die du per Mail schickst (1–20). Standard 1.
DURCHLAUF_ANZAHL=1

# Worauf am Ende gewartet wird:
#   abgeholt          (Standard) n8n hat den Beleg abgeholt (Status «abgeholt»). Paperless/Bexio prüfst du von Hand.
#   archiv_bestaetigt n8n hat nach dem Paperless-Upload archivierung-bestaetigen aufgerufen (braucht den API-Schlüssel).
DURCHLAUF_ENDE=abgeholt

# Optional: n8n-API-Schlüssel der TESTINSTANZ. Nur für den lesenden Abruf
# GET /api/n8n/jobs/archivierung-ausstehend (Archivquittungen sind in der Oberfläche nicht sichtbar).
# Pflicht bei DURCHLAUF_ENDE=archiv_bestaetigt.
DURCHLAUF_N8N_API_KEY=

# Zeitlimits und Abfrageintervall
DURCHLAUF_ZEITLIMIT_EINGANG_MIN=15
DURCHLAUF_ZEITLIMIT_SCHRITT_S=120
DURCHLAUF_ZEITLIMIT_EXPORT_MIN=30
DURCHLAUF_ABFRAGE_S=20

# Kontierungswerte, falls das Formular sie nicht aus der QR-Erkennung vorbelegt (Belege ohne QR-Code):
# Lieferant genau wie in der Auswahl, Betrag, letzte 4 Zeichen der IBAN (Testbelege R4…: 3456).
DURCHLAUF_LIEFERANT=
DURCHLAUF_BETRAG=
DURCHLAUF_IBAN_ENDUNG=
# Zahlungsziel in Tagen ab heute, wenn nicht vorbelegt. Absender, wenn der Eingang keinen mitbringt.
DURCHLAUF_ZAHLUNGSZIEL_TAGE=30
DURCHLAUF_ABSENDER=durchlauf-test@example.invalid
# Rechnungsnummer, wenn nicht vorbelegt: <Präfix>-<Zeit>-<Beleg-ID> (eindeutig je Lauf).
DURCHLAUF_RECHNUNGSNUMMER_PRAEFIX=DT

# Prüf-Popup bei der Kontierung (Auffälligkeiten wie Dubletten-Verdacht):
#   bestaetigen (Standard) «Geprüft, trotzdem speichern» mit Bemerkung «Automatischer Durchlauf-Test»
#   abbrechen   Beleg als Fehler melden
DURCHLAUF_AUFFAELLIGKEITEN=bestaetigen

# Ordner für gespeicherte Sitzungen und Fehlerbilder (git-ignoriert). Standard .durchlauf
DURCHLAUF_ORDNER=.durchlauf
