<%- include('../_seite_anfang', { titel: 'Altfälle' }) %>
<% /* Ansichtswahl (src/middleware/ansicht.js): 'tabelle', 'kacheln' oder 'auto' (Kacheln unter lg, sonst Tabelle). */
   const gewaehlteAnsicht = (typeof ansicht !== 'undefined' && ansicht) || 'auto';
   const zeigeTabelle = gewaehlteAnsicht !== 'kacheln';
   const zeigeKacheln = gewaehlteAnsicht !== 'tabelle';
   const klasseTabelle = 'ansicht-tabelle' + (gewaehlteAnsicht === 'auto' ? ' d-none d-lg-block' : '');
   const klasseKacheln = 'ansicht-kacheln' + (gewaehlteAnsicht === 'auto' ? ' d-lg-none' : ''); %>
    <div class="seitenkopf">
      <h1 class="seitenkopf-titel">Altfälle ohne Freigabe-/Zahlungsnachweis</h1>
      <div class="seitenkopf-aktionen"><%- include('../_ansicht_umschalter') %></div>
    </div>
    <p class="text-muted">Diese Belege sind abgeschlossen, aber ohne belastbaren Freigabe-Snapshot oder ohne ausdrücklich bestätigte Zahlungsdaten. Sie werden nicht an n8n übergeben, bis hier entschieden wurde.</p>
    <% if (gespeichert) { %>
      <div class="alert alert-success" role="alert">Entscheidung gespeichert.</div>
    <% } %>
    <% if (altfaelle.length === 0) { %>
      <p>Keine offenen Altfälle.</p>
    <% } else { %>
      <% if (zeigeTabelle) { %><div class="<%= klasseTabelle %>">
      <div class="table-responsive">
        <table class="table align-middle">
          <thead><tr><th>Job</th><th>Art</th><th>Dateiname</th><th>Grund</th><th></th></tr></thead>
          <tbody>
            <% altfaelle.forEach((fall) => { %>
              <tr>
                <td><%= fall.job.id %></td>
                <td><%= fall.gruppe ? 'Splitgruppe' : fall.job.quelle === 'spesen' ? 'Spesen' : 'Rechnung' %></td>
                <td><%= fall.job.dateiname %></td>
                <td><%= fall.grund %></td>
                <td><a href="/admin/altfaelle/<%= fall.job.id %>" class="btn btn-outline-primary btn-sm">Prüfen</a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      </div><% } %>
      <% if (zeigeKacheln) { %><div class="<%= klasseKacheln %>"><%- include('_altfaelle_kacheln', { altfaelle }) %></div><% } %>
    <% } %>
<%- include('../_seite_ende') %>
