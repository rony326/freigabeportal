<!DOCTYPE html>
<html lang="de"<% if (branding.themeAttr) { %> data-theme="<%= branding.themeAttr %>" data-bs-theme="<%= branding.bsThemeAttr %>"<% } %>>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="/vendor/bootstrap/bootstrap.min.css">
  <title>Aufgaben — <%= branding.seitenTitel %></title>
</head>
<body>
  <%- include('_header', { navContainerClass: 'container-fluid px-4' }) %>
  <main class="container-fluid px-4 py-4">
    <h1>Aufgaben</h1>

    <% if (typeof isBuchhaltung !== 'undefined' && (isBuchhaltung || isPortalAdmin)) { %>
      <h2 class="h4 mt-4">Pool</h2>
      <%- include('_job_table', { jobs: poolJobs, idPrefix: 'pool', leerText: 'Keine offenen Rechnungen im Pool.' }) %>
    <% } %>

    <% if (typeof isPortalAdmin !== 'undefined' && isPortalAdmin) { %>
      <h2 class="h4 mt-4">An Portal-Admin eskalierte Kontierungen</h2>
      <%- include('_job_table', { jobs: adminEskalierteKontierungen, idPrefix: 'admin-eskalation-kontierung', linkPrefix: '/kontierung', aktionLabel: 'Kontieren', leerText: 'Keine an Portal-Admin eskalierten Kontierungen.' }) %>

      <h2 class="h4 mt-4">An Portal-Admin eskalierte Freigaben</h2>
      <%- include('_job_table', { jobs: adminEskalierteFreigaben, idPrefix: 'admin-eskalation-freigabe', linkPrefix: '/freigabe2', aktionLabel: 'Freigeben', leerText: 'Keine an Portal-Admin eskalierten Freigaben.' }) %>
    <% } %>

    <h2 class="h4 mt-4">Meine offenen Kontierungen</h2>
    <%- include('_job_table', { jobs: meineKontierungen, idPrefix: 'kontierung', linkPrefix: '/kontierung', aktionLabel: 'Kontieren', leerText: 'Keine offenen Kontierungen.' }) %>

    <h2 class="h4 mt-4">Meine Freigaben</h2>
    <%- include('_job_table', { jobs: meineFreigaben, idPrefix: 'freigabe2', linkPrefix: '/freigabe2', aktionLabel: 'Freigeben', leerText: 'Keine offenen Freigaben.' }) %>

    <h2 class="h4 mt-4">Meine abgelehnten Jobs</h2>
    <%- include('_job_table', { jobs: meineAbgelehnten, idPrefix: 'abgelehnt', linkPrefix: '/abgelehnt', aktionLabel: 'Ansehen', leerText: 'Keine abgelehnten Rechnungen.' }) %>

    <dialog id="preview-dialog" class="p-0 border-0 rounded">
      <div class="d-flex justify-content-end p-2 bg-body border-bottom">
        <button type="button" id="preview-dialog-close" class="btn btn-outline-secondary btn-sm">Schließen</button>
      </div>
      <iframe id="preview-frame" src="" class="pdf-preview" style="width:80vw;height:80vh"></iframe>
    </dialog>
  </main>

  <script>
    document.querySelectorAll('.beanspruchen-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.dataset.jobId;
        const res = await fetch(`/api/pool/${id}/beanspruchen`, { method: 'POST' });
        if (res.ok) {
          window.location.href = `/kontierung/${id}`;
          return;
        }
        const body = await res.json().catch(() => ({}));
        const row = document.getElementById(`pool-row-${id}`);
        if (row) {
          const msg = document.createElement('tr');
          const cell = document.createElement('td');
          cell.colSpan = 4;
          cell.textContent = body.error || 'Job ist nicht mehr verfügbar.';
          msg.appendChild(cell);
          row.replaceWith(msg);
        }
      });
    });

    function oeffneVorschau(relativeUrl) {
      // Rendered via PDF.js (public/vendor/pdfjs), not the browser's native PDF plugin:
      // Chrome's "Download PDFs instead of automatically opening them" setting blocks native
      // inline rendering inside an <iframe> entirely (shows an Open-button placeholder that
      // downloads instead of previewing), regardless of Content-Disposition. PDF.js renders
      // via canvas/JS and is unaffected by that setting.
      // The file= value must be an absolute URL: PDF.js's viewer runs `new URL(file)` with no
      // base, which throws for a relative path like ours — its fallback then treats the whole
      // string (query string included) as a literal filename, so expires/signature never reach
      // the server as real query params and every preview 403s. Resolving against
      // location.origin here keeps it a real, absolute, still-relative-to-this-host URL.
      const absoluteUrl = new URL(relativeUrl, window.location.origin).href;
      document.getElementById('preview-frame').src = '/vendor/pdfjs/web/viewer.html?file=' + encodeURIComponent(absoluteUrl);
      document.getElementById('preview-dialog').showModal();
    }

    document.querySelectorAll('.thumbnail-preview').forEach((img) => {
      img.addEventListener('click', () => {
        // The preview URL baked into the page at render time may already have expired if the
        // dashboard has been open for a while (signed links are short-lived, see
        // PDF_PREVIEW_TTL_SECONDS) — fetch a freshly-signed one for this click instead of
        // reusing the stale one, falling back to it only if the refresh itself fails.
        fetch(`/downloads/${img.dataset.jobId}/refresh-url`)
          .then((res) => (res.ok ? res.json() : Promise.reject()))
          .then((data) => oeffneVorschau(data.url))
          .catch(() => oeffneVorschau(img.dataset.previewUrl));
      });
    });
    document.getElementById('preview-dialog-close').addEventListener('click', () => {
      document.getElementById('preview-dialog').close();
      document.getElementById('preview-frame').src = '';
    });
  </script>
  <%- include('_footer') %>
</body>
</html>
