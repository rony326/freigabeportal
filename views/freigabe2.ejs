<%- include('_seite_anfang', { titel: 'Freigabe 2', rahmen: 'kompakt' }) %>
<% const ff = locals.feldFehler || {}; const ffAttr = locals.feldFehlerAttr || (() => ''); %>
    <div class="seitenkopf">
      <h1 class="seitenkopf-titel">Freigabe 2: <%- include('_beleg_name', { job }) %> <%- include('_beleg_nr', { jobId: job.id }) %></h1>
    </div>
    <div class="row g-3 beleg-umschalter" data-beleg-umschalter data-refresh-url="/downloads/<%= job.id %>/refresh-url">
      <%- include('_beleg_umschalter', { jobId: job.id, pdfUrl: `/downloads/${job.id}/oeffnen`, thumbnailUrl: job.thumbnail_pfad ? `/downloads/${job.id}/thumbnail` : null, refreshUrl: `/downloads/${job.id}/refresh-url`, previewUrl, frameId: 'freigabe2-preview-frame', spalte: 'col-lg-7' }) %>
      <div class="col-lg-5 beleg-umschalter-formular" id="beleg-umschalter-formular">
        <div class="card">
          <div class="card-body">
            <% if (typeof kkHinweis !== 'undefined' && kkHinweis) { %>
              <div class="alert <%= kkHinweis.startsWith('Kreditkartenbeleg') ? 'alert-info' : 'alert-warning' %> py-2"><%= kkHinweis %></div>
            <% } %>
            <div class="entscheidung">
              <div class="entscheidung-betrag"><%= job.betrag || '—' %><% if (job.typ === 'gutschrift') { %> <span class="badge text-bg-secondary fs-6 fw-normal align-middle">Gutschrift</span><% } %></div>
              <% if (job.quelle === 'spesen') { %>
                <div>Eingereicht von <%= spesenEinreicher ? `${spesenEinreicher.vorname} ${spesenEinreicher.nachname}` : 'Unbekannt' %></div>
              <% } else if (job.lieferant) { %>
                <div><%= job.lieferant %></div>
              <% } %>
              <div class="text-muted">Konto <%= konto.kontonummer %> — <%= konto.bezeichnung %></div>
            </div>
            <dl class="kachel-angaben">
              <dt>Quelle</dt><dd><%= job.quelle === 'scanner' ? 'Scanner' : job.quelle === 'spesen' ? 'Spesen' : 'Lieferant' %></dd>
              <% if (job.absender) { %><dt>Absender</dt><dd><%= job.absender %></dd><% } %>
              <% if (job.quelle === 'spesen') { %>
                <% if (spesenabrechnungTitel) { %><dt>Titel</dt><dd><%= spesenabrechnungTitel %></dd><% } %>
                <dt>Verwendungszweck</dt><dd><%= job.beschreibung %></dd>
                <dt>Auslage-Datum</dt><dd><%= job.auslage_datum %></dd>
              <% } else { %>
                <% if (job.rechnungsnummer) { %><dt>Rechnungsnummer</dt><dd><%= job.rechnungsnummer %></dd><% } %>
                <% if (job.zahlungsziel) { %><dt>Zahlungsziel</dt><dd><%= job.zahlungsziel %></dd><% } %>
              <% } %>
              <dt>Freigeber 1</dt><dd><%= freigeber1Person.vorname %> <%= freigeber1Person.nachname %></dd>
              <dt>Interessenskonflikt Freigeber 1</dt><dd><%= freigabe1.interessenskonflikt ? 'Ja' : 'Nein' %></dd>
              <% if (freigabe1.kommentar) { %><dt>Begründung</dt><dd><%= freigabe1.kommentar %></dd><% } %>
            </dl>

            <%- include('_fehler_liste', { errors, feldFehler: locals.feldFehler || {} }) %>

            <form method="post" action="/freigabe2/<%= job.id %>" id="freigabe2-form">
              <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
              <input type="hidden" name="kommentar_stand" value="<%= locals.kommentarStand || '0:0' %>">
              <% if (typeof zahlungsart !== 'undefined' && zahlungsart === 'keine_zahlung') { %>
                <p class="text-muted">Zahlung: keine (Gutschrift) — es werden keine Zahlungsdaten exportiert.</p>
              <% } else if (typeof zahlungsart !== 'undefined' && zahlungsart === 'ohne_zahlungsdaten' && !paymentReview) { %>
                <p class="text-muted">Zahlung: keine maschinenlesbaren Zahlungsdaten — die Zahlung wird manuell erfasst.</p>
              <% } %>
              <% if (paymentReview) { %>
                <div class="border rounded p-2 mb-3" id="zahlungsdatenPruefung">
                  <h2 class="h5">Zahlungsdaten</h2>
                  <% const daten = paymentReview.daten || {}; %>
                  <% if (paymentReview.art === 'spesen') { %>
                    <p class="mb-1"><strong>IBAN:</strong> <span class="text-break"><%= daten.iban %></span></p>
                    <p class="mb-1"><strong>Kontoinhaber:</strong> <span class="text-break"><%= daten.kontoinhaber %></span></p>
                  <% } else if (paymentReview.art === 'qr_rechnung') { %>
                    <p class="mb-1"><strong>Zahlungsempfaenger:</strong> <span class="text-break"><%= daten.empfaenger %></span></p>
                    <% if (paymentReview.abgleich === 'abweichung') { %>
                      <div class="alert alert-danger py-2 mb-1"><strong>IBAN:</strong> <span class="text-break"><%= daten.iban %></span> — NICHT bei diesem Lieferanten hinterlegt</div>
                    <% } else { %>
                      <p class="mb-1"><strong>IBAN:</strong> <span class="text-break"><%= daten.iban %></span></p>
                    <% } %>
                    <% if (daten.referenz) { %><p class="mb-1"><strong>Referenz:</strong> <span class="text-break"><%= daten.referenz %></span></p><% } %>
                    <% if (daten.betrag) { %><p class="mb-1"><strong>QR-Betrag:</strong> <%= daten.betrag %> <%= daten.waehrung || '' %></p><% } %>
                    <% if (paymentReview.abgleich !== 'abweichung') { %><p class="mb-1"><strong>IBAN-Abgleich:</strong> <%= { uebereinstimmung: 'bei diesem Lieferanten hinterlegt', abweichung: 'NICHT bei diesem Lieferanten hinterlegt', keine_iban_hinterlegt: 'keine IBAN beim Lieferanten hinterlegt', kein_lieferant: 'kein Lieferant zugeordnet' }[paymentReview.abgleich] || paymentReview.abgleich %></p><% } %>
                  <% } %>
                  <% (paymentReview.hinweisTexte || []).forEach((text) => { %>
                    <div class="alert alert-warning py-2 my-2"><%= text %></div>
                  <% }) %>
                  <input type="hidden" name="zahlungsdaten_stand" value="<%= paymentReview.fingerprint %>">
                  <div class="form-check">
                    <input class="form-check-input<%= ff.zahlungsdatenBestaetigt ? ' is-invalid' : '' %>" type="checkbox" name="zahlungsdaten_bestaetigt" id="zahlungsdatenBestaetigt" value="ja"<%- ffAttr(ff, 'zahlungsdatenBestaetigt') %>>
                    <label class="form-check-label" for="zahlungsdatenBestaetigt"><%= paymentReview.art === 'spesen' ? 'IBAN, Kontoinhaber, Betrag und Konto geprueft' : paymentReview.art === 'qr_rechnung' ? 'Zahlungsempfaenger, IBAN, Referenz, Betrag und Konto geprueft' : 'Zahlung wird manuell erfasst; Konto und Betrag geprueft' %></label>
<% if (ff.zahlungsdatenBestaetigt) { %><div class="invalid-feedback d-block" id="zahlungsdatenBestaetigt-fehler"><%= ff.zahlungsdatenBestaetigt %></div><% } %>
                  </div>
                  <% if ((paymentReview.hinweise || []).length > 0) { %>
                    <div class="form-check">
                      <input class="form-check-input<%= ff.zahlungshinweiseBestaetigt ? ' is-invalid' : '' %>" type="checkbox" name="zahlungshinweise_bestaetigt" id="zahlungshinweiseBestaetigt" value="ja"<%- ffAttr(ff, 'zahlungshinweiseBestaetigt') %>>
                      <label class="form-check-label" for="zahlungshinweiseBestaetigt">Die oben genannten Abweichungen wurden geklaert</label>
<% if (ff.zahlungshinweiseBestaetigt) { %><div class="invalid-feedback d-block" id="zahlungshinweiseBestaetigt-fehler"><%= ff.zahlungshinweiseBestaetigt %></div><% } %>
                    </div>
                  <% } %>
                </div>
              <% } %>
              <div class="mb-3">
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="interessenskonflikt" id="f2konfliktNein" value="nein" <%= values.interessenskonflikt !== 'ja' ? 'checked' : '' %>>
                  <label class="form-check-label" for="f2konfliktNein">Kein Interessenskonflikt</label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="interessenskonflikt" id="f2konfliktJa" value="ja" <%= values.interessenskonflikt === 'ja' ? 'checked' : '' %>>
                  <label class="form-check-label" for="f2konfliktJa">Interessenskonflikt</label>
                </div>
              </div>
              <div class="mb-3">
                <label class="form-label" for="f2begruendung">Begründung <span class="text-muted" data-begruendung-hinweis><%= values.interessenskonflikt === 'ja' ? '(Pflicht)' : '(bei Ablehnung Pflicht)' %></span></label>
                <textarea class="form-control<%= ff.f2begruendung ? ' is-invalid' : '' %>" id="f2begruendung" name="begruendung" data-begruendung-pflicht-bei="f2konfliktJa"<%- ffAttr(ff, 'f2begruendung') %>><%= values.begruendung || '' %></textarea>
<% if (ff.f2begruendung) { %><div class="invalid-feedback d-block" id="f2begruendung-fehler"><%= ff.f2begruendung %></div><% } %>
              </div>
              <button type="submit" name="aktion" value="freigeben" class="btn btn-primary me-2"><%= job.quelle === 'spesen' && !paymentReview ? 'Zahlungsdaten pruefen' : 'Freigeben' %></button>
              <button type="submit" name="aktion" value="ablehnen" class="btn btn-outline-danger">Ablehnen</button>
            </form>
          </div>
        </div>
        <%- include('_audit_log') %>
        <% if (locals.kommentarBereich) { %><%- include('_kommentare', { ...kommentarBereich, ungespeichertesFormular: 'freigabe2-form' }) %><% } %>
      </div>
    </div>
<%- include('_ablehnen_dialog', { formId: 'freigabe2-form', begruendungId: 'f2begruendung' }) %>
<%- include('_seite_ende') %>
