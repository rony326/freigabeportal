<%- include('_seite_anfang', { titel: 'Kontierung', rahmen: 'kompakt' }) %>
<% const ff = locals.feldFehler || {}; const ffAttr = locals.feldFehlerAttr || (() => ''); %>
    <div class="seitenkopf">
      <h1 class="seitenkopf-titel">Kontierung: <%- include('_beleg_name', { job }) %> <%- include('_beleg_nr', { jobId: job.id }) %></h1>
    </div>
    <div class="row g-3 beleg-umschalter" data-beleg-umschalter data-refresh-url="/downloads/<%= job.id %>/refresh-url">
      <div class="col-12">
        <% if (typeof kkHinweis !== 'undefined' && kkHinweis) { %>
          <div class="alert <%= kkHinweis.startsWith('Kreditkartenbeleg') ? 'alert-info' : 'alert-warning' %> py-2"><%= kkHinweis %></div>
        <% } %>
        <%- include('_auffaelligkeiten_bestaetigt', { kasten: locals.auffaelligkeitenBestaetigt }) %>
        <p class="text-muted">Quelle: <%= job.quelle === 'scanner' ? 'Scanner' : 'Lieferant' %></p>
      </div>
      <div class="w-100"></div>
      <%- include('_beleg_umschalter', { jobId: job.id, pdfUrl: `/downloads/${job.id}/oeffnen`, thumbnailUrl: job.thumbnail_pfad ? `/downloads/${job.id}/thumbnail` : null, refreshUrl: `/downloads/${job.id}/refresh-url`, previewUrl, frameId: 'kontierung-preview-frame', spalte: 'col-lg-7' }) %>
      <div class="col-lg-5 beleg-umschalter-formular" id="beleg-umschalter-formular">
        <div class="card">
          <div class="card-body">
            <% if (typeof qrInfo !== 'undefined' && qrInfo) { %>
              <div class="alert alert-info">
                <strong>Aus QR-Code erkannt:</strong>
                IBAN <%= qrInfo.iban %><% if (qrInfo.creditorName) { %> (<%= qrInfo.creditorName %>)<% } %>
                <% if (qrInfo.betrag) { %>, Betrag <%= qrInfo.betrag %> <%= qrInfo.waehrung || '' %><% } %>
                <% if (qrInfo.referenz) { %>, Referenz <%= qrInfo.referenz %><% } %>
                <% if (qrInfo.abgleich && qrInfo.abgleich.status === 'match') { %>
                  <div class="mt-1 text-success">IBAN stimmt mit hinterlegten Daten überein.</div>
                <% } %>
              </div>
            <% } %>
            <% if (typeof qrInfo !== 'undefined' && qrInfo && qrInfo.konfliktMitZugewiesenemKreditor) { %>
              <div class="alert alert-warning">
                QR-Code deutet auf Lieferant <strong><%= qrInfo.vorschlagKreditor.name %></strong> hin, aktuell zugewiesen: <strong><%= qrInfo.zugewiesenerKreditor.name %></strong> — bitte prüfen.
              </div>
            <% } %>
            <%- include('_fehler_liste', { errors, feldFehler: locals.feldFehler || {} }) %>
            <% if (locals.auffaelligkeiten) { %><%- include('_auffaelligkeiten_modal', { auffaelligkeiten, values, formId: 'kontierung-form', submitName: 'aktion', submitValue: 'kontieren' }) %><% } %>

            <form id="kontierung-form" method="post" action="/kontierung/<%= job.id %>" enctype="multipart/form-data">
              <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
              <div class="kontierung-block">
              <div class="mb-3">
                <label class="form-label" for="kontoId">Konto</label>
                <select class="form-select<%= ff.kontoId ? ' is-invalid' : '' %>" id="kontoId" name="kontoId" required data-searchable<%- ffAttr(ff, 'kontoId') %>>
                  <option value="">— wählen —</option>
                  <% konten.forEach((k) => { %>
                    <option value="<%= k.id %>" data-buchungsart="<%= k.buchungsart %>" <%= String(k.id) === values.kontoId ? 'selected' : '' %>><%= k.kontonummer %> — <%= k.bezeichnung %></option>
                  <% }) %>
                </select>
                <div class="form-text text-warning" id="konto-typ-hinweis" role="status" aria-live="polite" hidden>Das gewählte Konto passt nicht zum Typ – bitte neu wählen.</div>
<% if (ff.kontoId) { %><div class="invalid-feedback d-block" id="kontoId-fehler"><%= ff.kontoId %></div><% } %>
              </div>

              <div class="row g-2 mb-3">
                <div class="col-12 col-sm-6">
                  <label class="form-label" for="absender">Absender</label>
                  <input type="text" class="form-control<%= ff.absender ? ' is-invalid' : '' %>" id="absender" name="absender" value="<%= values.absender || '' %>" required<%- ffAttr(ff, 'absender') %>>
<% if (ff.absender) { %><div class="invalid-feedback d-block" id="absender-fehler"><%= ff.absender %></div><% } %>
                </div>
                <div class="col-12 col-sm-6">
                  <label class="form-label" for="kreditorId">Lieferant</label>
                  <select class="form-select<%= ff.kreditorId ? ' is-invalid' : '' %>" id="kreditorId" name="kreditorId" required data-searchable<%- ffAttr(ff, 'kreditorId') %>>
                    <option value="">— wählen —</option>
                    <% kreditoren.forEach((d) => { %>
                      <option value="<%= d.id %>" data-iban-pflicht="<%= d.zahlungsart === 'ueberweisung' || d.zahlungsart === 'dauerauftrag' ? '1' : '0' %>" <%= String(d.id) === values.kreditorId ? 'selected' : '' %>><%= d.name %></option>
                    <% }) %>
                  </select>
<% if (ff.kreditorId) { %><div class="invalid-feedback d-block" id="kreditorId-fehler"><%= ff.kreditorId %></div><% } %>
<% if (!locals.darfLieferantAnlegen) { %><div class="form-text">Neue Lieferanten legt die Administration an.</div><% } %>
                </div>
              </div>

              </div>

              <% if (typeof qrInfo !== 'undefined' && qrInfo && qrInfo.iban) { %>
                <div class="mb-3">
                  <label class="form-label" for="qrIban">IBAN (aus QR-Code)</label>
                  <input type="text" class="form-control" id="qrIban" value="<%= qrInfo.iban %>" readonly>
                </div>
              <% } %>

              <div class="mb-3">
                <div class="form-check form-check-inline">
                  <input class="form-check-input" type="radio" name="typ" id="typRechnung" value="rechnung" <%= values.typ !== 'gutschrift' && values.typ !== 'rapport' ? 'checked' : '' %>>
                  <label class="form-check-label" for="typRechnung">Rechnung</label>
                </div>
                <div class="form-check form-check-inline">
                  <input class="form-check-input" type="radio" name="typ" id="typGutschrift" value="gutschrift" <%= values.typ === 'gutschrift' ? 'checked' : '' %>>
                  <label class="form-check-label" for="typGutschrift">Gutschrift</label>
                </div>
                <% if (typeof rapportModulAktiv !== 'undefined' && rapportModulAktiv) { %>
                  <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="typ" id="typRapport" value="rapport" <%= values.typ === 'rapport' ? 'checked' : '' %>>
                    <label class="form-check-label" for="typRapport">Nur zur Kenntnis (Rapport)</label>
                  </div>
                <% } %>
              </div>

              <% if (!job.qr_iban) {
                const gewaehlterKreditor = kreditoren.find((k) => String(k.id) === String(values.kreditorId));
                const ibanKastenSichtbar = Boolean(gewaehlterKreditor) && (gewaehlterKreditor.zahlungsart === 'ueberweisung' || gewaehlterKreditor.zahlungsart === 'dauerauftrag') && (values.typ || 'rechnung') === 'rechnung';
              %>
                <div class="alert alert-warning<%= ibanKastenSichtbar ? '' : ' d-none' %>" id="iban-manuell-kasten">
                  <h2 class="h5 alert-heading">Kein QR-Code: IBAN bitte von Hand prüfen</h2>
                  <p class="mb-2">Auf dieser Rechnung wurde kein QR-Code erkannt. Lies auf der Rechnung die IBAN des Lieferanten ab und gib die letzten 4 Zeichen ein. Die hinterlegte IBAN siehst du hier bewusst nicht.</p>
                  <label class="form-label" for="ibanEndung">Letzte 4 Zeichen der IBAN</label>
                  <input type="text" class="form-control w-auto<%= ff.ibanEndung ? ' is-invalid' : '' %>" id="ibanEndung" name="ibanEndung" value="<%= values.ibanEndung || '' %>" maxlength="9" autocomplete="off" spellcheck="false"<%= ibanKastenSichtbar ? ' required' : '' %><%- ffAttr(ff, 'ibanEndung') %>>
<% if (ff.ibanEndung) { %><div class="invalid-feedback d-block" id="ibanEndung-fehler"><%= ff.ibanEndung %></div><% } %>
                </div>
              <% } %>

              <div class="kontierung-block">
              <div class="mb-3">
                <label class="form-label" for="rechnungsnummer" id="rechnungsnummer-label">Rechnungsnummer</label>
                <input type="text" class="form-control<%= ff.rechnungsnummer ? ' is-invalid' : '' %>" id="rechnungsnummer" name="rechnungsnummer" value="<%= values.rechnungsnummer || '' %>" required<%- ffAttr(ff, 'rechnungsnummer') %>>
<% if (ff.rechnungsnummer) { %><div class="invalid-feedback d-block" id="rechnungsnummer-fehler"><%= ff.rechnungsnummer %></div><% } %>
              </div>

              <div class="row g-2 mb-3">
                <div class="col-12 col-sm-6">
                  <label class="form-label" for="betrag">Betrag</label>
                  <input type="text" inputmode="decimal" class="form-control<%= ff.betrag ? ' is-invalid' : '' %>" id="betrag" name="betrag" value="<%= values.betrag || '' %>" placeholder="z.B. 123.45" required<%- ffAttr(ff, 'betrag') %>>
<% if (ff.betrag) { %><div class="invalid-feedback d-block" id="betrag-fehler"><%= ff.betrag %></div><% } %>
                </div>
                <div class="col-12 col-sm-6">
                  <label class="form-label" for="zahlungsziel">Zahlungsziel</label>
                  <input type="date" class="form-control<%= ff.zahlungsziel ? ' is-invalid' : '' %>" id="zahlungsziel" name="zahlungsziel" value="<%= values.zahlungsziel || '' %>" <%= values.typ === 'gutschrift' ? '' : 'required' %><%- ffAttr(ff, 'zahlungsziel') %>>
<% if (ff.zahlungsziel) { %><div class="invalid-feedback d-block" id="zahlungsziel-fehler"><%= ff.zahlungsziel %></div><% } %>
                </div>
              </div>

              <div class="mb-3">
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="interessenskonflikt" id="konfliktNein" value="nein" <%= values.interessenskonflikt !== 'ja' ? 'checked' : '' %>>
                  <label class="form-check-label" for="konfliktNein">Kein Interessenskonflikt</label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="interessenskonflikt" id="konfliktJa" value="ja" <%= values.interessenskonflikt === 'ja' ? 'checked' : '' %>>
                  <label class="form-check-label" for="konfliktJa">Interessenskonflikt</label>
                </div>
              </div>

              <div class="mb-3">
                <label class="form-label" for="begruendung">Begründung <span class="text-muted" data-begruendung-hinweis><%= values.interessenskonflikt === 'ja' ? '(Pflicht)' : '(bei Ablehnung Pflicht)' %></span></label>
                <textarea class="form-control<%= ff.begruendung ? ' is-invalid' : '' %>" id="begruendung" name="begruendung" data-begruendung-pflicht-bei="konfliktJa"<%- ffAttr(ff, 'begruendung') %>><%= values.begruendung || '' %></textarea>
<% if (ff.begruendung) { %><div class="invalid-feedback d-block" id="begruendung-fehler"><%= ff.begruendung %></div><% } %>
              </div>

              <div class="mb-3">
                <label class="form-label" for="beleg">Beleg anhängen <span class="text-muted">(optional, z.B. Einzelbeleg zu einer Kreditkartenabrechnung — PDF, PNG oder JPEG)</span></label>
                <input type="file" class="form-control" id="beleg" name="beleg" accept="application/pdf,image/png,image/jpeg">
              </div>

              </div>

              <% if (typeof rapportModulAktiv !== 'undefined' && rapportModulAktiv) { %>
                <div id="rapport-block" class="d-none">
                  <div class="mb-3">
                    <label class="form-label" for="rapportEmpfaenger">Empfängerinnen und Empfänger <span class="text-muted">(Mehrfachauswahl mit Strg/Cmd)</span></label>
                    <select class="form-select" id="rapportEmpfaenger" name="empfaengerIds" multiple size="8" disabled>
                      <% rapportEmpfaengerKandidaten.forEach((p) => { %>
                        <option value="<%= p.churchtools_person_id %>" <%= (values.rapportEmpfaengerIds || []).includes(p.churchtools_person_id) ? 'selected' : '' %>><%= p.nachname %> <%= p.vorname %></option>
                      <% }) %>
                    </select>
                  </div>
                  <div class="mb-3">
                    <label class="form-label" for="rapportBemerkung">Bemerkung <span class="text-muted">(optional, höchstens 2000 Zeichen)</span></label>
                    <textarea class="form-control" id="rapportBemerkung" name="bemerkung" maxlength="2000" disabled><%= values.rapportBemerkung || '' %></textarea>
                  </div>
                </div>
              <% } %>

            </form>
            <form id="an-gruppe-zurueck-form" method="post" action="/kontierung/<%= job.id %>/an-gruppe-zurueck">
              <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
            </form>

            <div class="d-flex flex-wrap gap-2 align-items-center">
              <button type="submit" form="kontierung-form" name="aktion" value="kontieren" class="btn btn-primary">Kontieren</button>
              <button type="submit" form="kontierung-form" name="aktion" value="ablehnen" id="ablehnen-btn" class="btn btn-outline-danger">Ablehnen</button>
              <% if (typeof rapportModulAktiv !== 'undefined' && rapportModulAktiv) { %>
                <button type="submit" form="kontierung-form" name="aktion" value="rapport" id="rapport-btn" class="btn btn-primary d-none" disabled>Zur Kenntnis weitergeben</button>
              <% } %>
              <div class="dropdown">
                <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Weitere Aktionen</button>
                <ul class="dropdown-menu">
                  <li><button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#zurueck-in-pool-modal">Zurück in den Pool legen</button></li>
                  <li><button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#an-gruppe-zurueck-modal">An Gruppe zurücksenden</button></li>
                  <li><button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#aufsplitten-modal">Rechnung aufsplitten</button></li>
                  <% if (typeof kkKarten !== 'undefined' && kkKarten.length > 0 && !job.aufgesplittet_von) { %>
                    <li><button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#kk-abrechnung-modal">Als Kreditkartenabrechnung übergeben …</button></li>
                  <% } %>
                </ul>
              </div>
            </div>
          </div>
        </div>
        <%- include('_audit_log') %>
        <% if (locals.kommentarBereich) { %><%- include('_kommentare', { ...kommentarBereich, ungespeichertesFormular: 'kontierung-form' }) %><% } %>
      </div>
    </div>

    <% if (typeof kkKarten !== 'undefined' && kkKarten.length > 0 && !job.aufgesplittet_von) { %>
    <div class="modal fade" id="kk-abrechnung-modal" tabindex="-1" aria-labelledby="kk-abrechnung-modal-label" aria-hidden="true">
      <div class="modal-dialog">
        <form class="modal-content" method="post" action="/kontierung/<%= job.id %>/als-kk-abrechnung">
          <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
          <div class="modal-header">
            <h5 class="modal-title" id="kk-abrechnung-modal-label">Als Kreditkartenabrechnung übergeben</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schliessen"></button>
          </div>
          <div class="modal-body">
            <label class="form-label" for="kk-karte">Kreditkartenabrechnung für</label>
            <select class="form-select" id="kk-karte" name="kreditkarteId" required>
              <option value="">— Karte —</option>
              <% kkKarten.forEach((k) => { %><option value="<%= k.id %>"><%= k.bezeichnung %><%= k.karte_endziffern ? ` (•••• ${k.karte_endziffern})` : '' %></option><% }) %>
            </select>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Abbrechen</button>
            <button type="submit" class="btn btn-primary">Zum Abgleich übergeben</button>
          </div>
        </form>
      </div>
    </div>
    <% } %>

    <div class="modal fade" id="aufsplitten-modal" tabindex="-1" aria-labelledby="aufsplitten-modal-label" aria-hidden="true">
      <div class="modal-dialog modal-xl modal-dialog-scrollable" style="height:90vh">
        <div class="modal-content" style="height:100%">
          <div class="modal-header">
            <h5 class="modal-title" id="aufsplitten-modal-label">Rechnung aufsplitten</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schliessen"></button>
          </div>
          <div class="modal-body p-0">
            <iframe id="aufsplitten-frame" title="Rechnung aufsplitten" style="width:100%;height:100%;border:0"></iframe>
          </div>
        </div>
      </div>
    </div>

    <%- include('_zurueck_in_pool_dialog', { alleKonten, zurueckInPoolAction: '/kontierung/' + job.id + '/zurueck-in-pool' }) %>
    <%- include('_ablehnen_dialog', { formId: 'kontierung-form', begruendungId: 'begruendung' }) %>

    <div class="modal fade" id="an-gruppe-zurueck-modal" tabindex="-1" aria-labelledby="an-gruppe-zurueck-modal-label" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="an-gruppe-zurueck-modal-label">An Gruppe zurücksenden</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schliessen"></button>
          </div>
          <div class="modal-body">
            <div class="mb-3">
              <label class="form-label" for="bemerkung-ruecksendung">Bemerkung <span class="text-muted">(Pflicht)</span></label>
              <textarea class="form-control" id="bemerkung-ruecksendung" name="bemerkung" form="an-gruppe-zurueck-form" required></textarea>
              <div class="form-text">Die Rechnung geht zurück an das Team, das Pool-Belege zuweisen kann, mit deiner Bemerkung.</div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Abbrechen</button>
            <button type="submit" form="an-gruppe-zurueck-form" class="btn btn-primary">An Gruppe zurücksenden</button>
          </div>
        </div>
      </div>
    </div>

    <% if (locals.darfLieferantAnlegen) { %>
    <div class="modal fade" id="neuer-lieferant-modal" tabindex="-1" aria-labelledby="neuer-lieferant-modal-label" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="neuer-lieferant-modal-label">Neuen Lieferanten anlegen</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schliessen"></button>
          </div>
          <div class="modal-body">
            <div id="neuer-lieferant-error" class="alert alert-danger d-none"></div>
            <div class="mb-3">
              <label class="form-label" for="neuer-lieferant-name">Name</label>
              <input type="text" class="form-control" id="neuer-lieferant-name">
            </div>
            <div class="mb-3">
              <label class="form-label" for="neuer-lieferant-zahlungsart">Zahlungsart</label>
              <select class="form-select" id="neuer-lieferant-zahlungsart">
                <% (locals.ZAHLUNGSARTEN || []).forEach((z) => { %>
                  <option value="<%= z %>"><%= ZAHLUNGSART_LABEL[z] || z %></option>
                <% }) %>
              </select>
            </div>
            <div class="mb-3" id="neuer-lieferant-iban-gruppe">
              <label class="form-label" for="neuer-lieferant-iban">IBAN</label>
              <input type="text" class="form-control" id="neuer-lieferant-iban" autocomplete="off" placeholder="z.B. CH93 0076 2011 6238 5295 7">
              <div class="form-text">Pflicht bei Überweisung und Dauerauftrag.</div>
            </div>
            <div class="mb-3">
              <label class="form-label" for="neuer-lieferant-konto">Konto (optional)</label>
              <select class="form-select" id="neuer-lieferant-konto" data-searchable>
                <option value="">— kein Konto —</option>
                <% konten.forEach((k) => { %>
                  <option value="<%= k.id %>"><%= k.kontonummer %> — <%= k.bezeichnung %></option>
                <% }) %>
              </select>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Abbrechen</button>
            <button type="button" class="btn btn-primary" id="neuer-lieferant-speichern">Anlegen</button>
          </div>
        </div>
      </div>
    </div>
    <% } %>
  <script src="/js/kontierung-iban.js?v=<%= locals.assetVersion || 0 %>" defer></script>
  <script src="/js/kontierung-konto-filter.js?v=<%= locals.assetVersion || 0 %>" defer></script>
  <% if (locals.auffaelligkeiten) { %><script src="/js/auffaelligkeiten.js?v=<%= locals.assetVersion || 0 %>" defer></script><% } %>
  <script nonce="<%= locals.cspNonce %>">
    // Eingebettetes PDF, "Vorschau neu laden" und Beleg/Formular-Umschalter: public/js/belegUmschalter.js.
    // Ablehnen deliberately needs none of these fields filled in (the server-side handler skips
    // all of these checks for aktion=ablehnen, only requiring Begründung) — but each field's HTML
    // `required` attribute is enforced by the browser before the form is even submitted,
    // regardless of which button triggered it. Drop them all the moment Ablehnen is clicked so
    // the browser lets an empty form through; a fresh page load (any validation error re-renders
    // the page) restores the attributes from the template.
    // Global, damit auch der Ablehnen-Dialog (views/_ablehnen_dialog.ejs) sie vor requestSubmit aufrufen kann.
    function entferneKontierungsPflicht() {
      ['kontoId', 'absender', 'kreditorId', 'rechnungsnummer', 'betrag', 'zahlungsziel'].forEach(function (id) {
        document.getElementById(id).required = false;
      });
      var ibanEndungFeld = document.getElementById('ibanEndung'); // nur ohne QR-Code vorhanden
      if (ibanEndungFeld) ibanEndungFeld.required = false;
    }
    document.getElementById('ablehnen-btn').addEventListener('click', function (e) {
      // Die defaultPrevented-Prüfung setzt voraus, dass _ablehnen_dialog.ejs vor diesem Skript eingebunden ist (Listener-Reihenfolge).
      // Mit Dialog-JS fängt _ablehnen_dialog.ejs den Klick ab; die Pflicht fällt erst bei der Bestätigung.
      if (!e.defaultPrevented) entferneKontierungsPflicht();
    });
    // Eine Gutschrift hat kein Fälligkeitsdatum — Zahlungsziel wird optional, sobald der Typ
    // umgeschaltet wird. Läuft auch einmal beim Laden, damit ein Fehler-Rerender mit bereits
    // gewähltem Typ=Gutschrift den Zustand korrekt wiederherstellt.
    (function () {
      var zahlungszielFeld = document.getElementById('zahlungsziel');
      var rechnungsnummerLabel = document.getElementById('rechnungsnummer-label');
      function aktualisiereTypUi() {
        var istGutschrift = document.getElementById('typGutschrift').checked;
        zahlungszielFeld.required = !istGutschrift;
        rechnungsnummerLabel.textContent = istGutschrift ? 'Gutschriftnummer' : 'Rechnungsnummer';
      }
      Array.prototype.forEach.call(document.querySelectorAll('input[name="typ"]'), function (radio) {
        radio.addEventListener('change', aktualisiereTypUi);
      });
      aktualisiereTypUi();
    })();
    // Typ «Nur zur Kenntnis (Rapport)»: Kontierungsfelder weg (deaktiviert, damit sie weder validiert
    // noch gesendet werden), Empfänger-Auswahl und Bemerkung dafür da. Umschalten zurück stellt alles her.
    <% if (typeof rapportModulAktiv !== 'undefined' && rapportModulAktiv) { %>
    (function () {
      var radio = document.getElementById('typRapport');
      var block = document.getElementById('rapport-block');
      var knopf = document.getElementById('rapport-btn');
      var kontierungKnoepfe = [document.querySelector('button[value="kontieren"]'), document.getElementById('ablehnen-btn'), document.querySelector('[data-bs-target="#aufsplitten-modal"]')];
      function umschalten() {
        var rapport = radio.checked;
        Array.prototype.forEach.call(document.querySelectorAll('.kontierung-block'), function (b) {
          b.classList.toggle('d-none', rapport);
          Array.prototype.forEach.call(b.querySelectorAll('input, select, textarea'), function (f) { f.disabled = rapport; });
        });
        block.classList.toggle('d-none', !rapport);
        Array.prototype.forEach.call(block.querySelectorAll('select, textarea'), function (f) { f.disabled = !rapport; });
        knopf.classList.toggle('d-none', !rapport);
        knopf.disabled = !rapport;
        kontierungKnoepfe.forEach(function (k) { if (k) k.classList.toggle('d-none', rapport); });
      }
      Array.prototype.forEach.call(document.querySelectorAll('input[name="typ"]'), function (r) {
        r.addEventListener('change', umschalten);
      });
      umschalten();
    })();
    <% } %>
    // "Rechnung aufsplitten" opens the existing standalone split page inside a Bootstrap modal via
    // an <iframe>, rather than navigating away — the page itself is unchanged (still a normal
    // GET/POST form) so error re-renders just update in place inside the modal. Two things need
    // JS glue because the split route was written for full-page navigation, not an iframe: (1) the
    // frame is only pointed at the route once the modal is actually opened, so it isn't fetched on
    // every Kontierung page load; (2) a successful split redirects to /pool server-side, which
    // would otherwise load /pool squeezed inside the small iframe — the load handler below detects
    // that and breaks the redirect out to the top-level window instead.
    (function () {
      var modal = document.getElementById('aufsplitten-modal');
      var frame = document.getElementById('aufsplitten-frame');
      var frameUrl = '/kontierung/<%= job.id %>/aufsplitten';
      var geladen = false;
      modal.addEventListener('shown.bs.modal', function () {
        if (!geladen) {
          geladen = true;
          // Carries over whatever Betrag is currently in the Kontierung form (from the
          // Originalrechnung, whether QR-erkannt or already saved) even if it hasn't been
          // submitted yet, so the split's Gesamtbetrag doesn't need to be typed in again.
          var betragFeld = document.getElementById('betrag');
          var betrag = betragFeld ? betragFeld.value.trim() : '';
          // Same for the Typ radio, so a Gutschrift chosen here stays a Gutschrift in the split.
          var typFeld = document.querySelector('input[name="typ"]:checked');
          // Und der gewählte Lieferant: das Aufsplitten prüft gegen ihn und verlangt ihn.
          var kreditorFeld = document.getElementById('kreditorId');
          var kreditorId = kreditorFeld ? kreditorFeld.value : '';
          var params = [];
          if (betrag) params.push('betrag=' + encodeURIComponent(betrag));
          if (kreditorId) params.push('kreditorId=' + encodeURIComponent(kreditorId));
          if (typFeld) params.push('typ=' + encodeURIComponent(typFeld.value));
          frame.src = params.length ? frameUrl + '?' + params.join('&') : frameUrl;
        }
      });
      frame.addEventListener('load', function () {
        try {
          if (frame.contentWindow.location.pathname === '/pool') {
            window.location.href = '/pool';
          }
        } catch (e) {
          // Same-origin by construction; nothing to do if the browser disagrees.
        }
      });
      // The split page's "Abbrechen" link can't close a modal in the parent document directly
      // (different document) — it posts a message instead, handled here.
      window.addEventListener('message', function (e) {
        if (e.origin === window.location.origin && e.data === 'aufsplitten-abbrechen') {
          bootstrap.Modal.getOrCreateInstance(modal).hide();
        }
      });
    })();
    // Progressively enhances any <select data-searchable> into a filterable combobox: a text
    // input the person can type into to narrow the list, backed by the original <select> as the
    // single source of truth for value/name/required (kept in the DOM, just visually hidden via
    // .visually-hidden rather than .d-none — a display:none form control is excluded from HTML5
    // constraint validation in every major browser, which would silently defeat the Konto
    // select's `required` and break the existing Ablehnen/Kontieren required-toggle above). No
    // "required" is ever set on the shadow input itself, so it never validates independently of
    // the real select.
    (function () {
      function optionLabel(opt) {
        return opt.textContent;
      }

      function enhance(select) {
        if (select.dataset.searchableEnhanced) return;
        select.dataset.searchableEnhanced = '1';

        var wrapper = document.createElement('div');
        wrapper.className = 'position-relative';
        select.parentNode.insertBefore(wrapper, select);

        var input = document.createElement('input');
        input.type = 'text';
        input.className = select.className;
        input.setAttribute('autocomplete', 'off');
        input.setAttribute('role', 'combobox');
        if (select.id) {
          input.id = select.id + '-suche';
          // Fehlerlinks auf das versteckte <select> führen stattdessen auf das sichtbare Feld.
          Array.prototype.forEach.call(document.querySelectorAll('a[href="#' + select.id + '"]'), function (link) {
            link.setAttribute('href', '#' + input.id);
            link.addEventListener('click', function (e) { e.preventDefault(); input.focus(); });
          });
        }
        // Fehlerzustand (aria-invalid/-describedby) gehört auf das sichtbare Feld.
        ['aria-invalid', 'aria-describedby'].forEach(function (attr) {
          if (select.hasAttribute(attr)) input.setAttribute(attr, select.getAttribute(attr));
        });
        input.setAttribute('aria-expanded', 'false');
        if (select.disabled) input.disabled = true;
        var placeholderOption = select.querySelector('option[value=""]');
        if (placeholderOption) input.placeholder = placeholderOption.textContent;

        wrapper.appendChild(input);
        wrapper.appendChild(select);
        select.classList.add('visually-hidden');

        var menu = document.createElement('div');
        menu.className = 'list-group position-absolute w-100 shadow-sm d-none';
        menu.style.zIndex = '1000';
        menu.style.maxHeight = '240px';
        menu.style.overflowY = 'auto';
        wrapper.appendChild(menu);

        var activeIndex = -1;

        function currentSelectedLabel() {
          var opt = select.options[select.selectedIndex];
          return opt && opt.value ? optionLabel(opt) : '';
        }

        function syncInputFromSelect() {
          input.value = currentSelectedLabel();
        }

        function highlight(items) {
          Array.prototype.forEach.call(items, function (item, i) {
            item.classList.toggle('active', i === activeIndex);
          });
          if (items[activeIndex]) items[activeIndex].scrollIntoView({ block: 'nearest' });
        }

        function renderMenu(filterText) {
          menu.innerHTML = '';
          activeIndex = -1;
          var lower = (filterText || '').toLowerCase();
          var any = false;
          Array.prototype.forEach.call(select.options, function (opt) {
            if (!opt.value || opt.disabled) return; // skip the "— wählen —" placeholder and Konten, die nicht zum Typ passen
            var label = optionLabel(opt);
            if (lower && label.toLowerCase().indexOf(lower) === -1) return;
            any = true;
            var item = document.createElement('button');
            item.type = 'button';
            item.className = 'list-group-item list-group-item-action py-1';
            item.textContent = label;
            item.dataset.value = opt.value;
            // mousedown (not click) fires before the input's blur handler hides the menu.
            item.addEventListener('mousedown', function (e) {
              e.preventDefault();
              select.value = opt.value;
              syncInputFromSelect();
              hideMenu();
              select.dispatchEvent(new Event('change', { bubbles: true }));
            });
            menu.appendChild(item);
          });
          if (!any) {
            var empty = document.createElement('div');
            empty.className = 'list-group-item text-muted py-1';
            empty.textContent = 'Keine Treffer';
            menu.appendChild(empty);
          }
        }

        function showMenu() {
          renderMenu(input.value === currentSelectedLabel() ? '' : input.value);
          menu.classList.remove('d-none');
          input.setAttribute('aria-expanded', 'true');
        }

        function hideMenu() {
          menu.classList.add('d-none');
          input.setAttribute('aria-expanded', 'false');
        }

        input.addEventListener('focus', showMenu);
        input.addEventListener('input', function () {
          renderMenu(input.value);
          menu.classList.remove('d-none');
        });
        input.addEventListener('blur', function () {
          // Delayed so the menu item's mousedown handler above still fires first.
          setTimeout(function () {
            hideMenu();
            input.value = currentSelectedLabel();
          }, 150);
        });
        input.addEventListener('keydown', function (e) {
          if (e.key === 'ArrowDown') {
            e.preventDefault();
            if (menu.classList.contains('d-none')) {
              showMenu();
              return;
            }
            var items = menu.querySelectorAll('[data-value]');
            activeIndex = Math.min(activeIndex + 1, items.length - 1);
            highlight(items);
          } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            activeIndex = Math.max(activeIndex - 1, 0);
            highlight(menu.querySelectorAll('[data-value]'));
          } else if (e.key === 'Enter') {
            var current = menu.querySelectorAll('[data-value]')[activeIndex];
            if (!menu.classList.contains('d-none') && current) {
              e.preventDefault();
              current.dispatchEvent(new MouseEvent('mousedown'));
            }
          } else if (e.key === 'Escape') {
            hideMenu();
          }
        });

        syncInputFromSelect();
      }

      function refresh(select) {
        var input = select.parentNode.querySelector('input[role="combobox"]');
        if (!input) return;
        var opt = select.options[select.selectedIndex];
        input.value = opt && opt.value ? optionLabel(opt) : '';
      }

      Array.prototype.forEach.call(document.querySelectorAll('select[data-searchable]'), enhance);
      window.SearchableSelect = { enhance: enhance, refresh: refresh };
    })();
    // "+ Neu" next to the Lieferant-Dropdown opens a modal to create a Kreditor on the fly, so a
    // person doesn't have to leave the Kontierung page (and lose their in-progress form) to go
    // through /admin/kreditoren just because the invoice's supplier isn't in the list yet. The Name
    // field is pre-filled from the Absender field already on this page, since that's usually
    // already the supplier's address/name lifted straight off the invoice.
    (function () {
      var modal = document.getElementById('neuer-lieferant-modal');
      if (!modal) return; // Nur Superadmin / Recht kreditoren_verwalten sehen die Schnellanlage.
      var zahlungsartSelect = document.getElementById('neuer-lieferant-zahlungsart');
      var ibanInput = document.getElementById('neuer-lieferant-iban');
      var ibanGruppe = document.getElementById('neuer-lieferant-iban-gruppe');
      function ibanSichtbarkeit() {
        ibanGruppe.classList.toggle('d-none', zahlungsartSelect.value !== 'ueberweisung' && zahlungsartSelect.value !== 'dauerauftrag');
      }
      zahlungsartSelect.addEventListener('change', ibanSichtbarkeit);
      var nameInput = document.getElementById('neuer-lieferant-name');
      var kontoSelect = document.getElementById('neuer-lieferant-konto');
      var errorBox = document.getElementById('neuer-lieferant-error');
      var kreditorSelect = document.getElementById('kreditorId');

      modal.addEventListener('show.bs.modal', function () {
        errorBox.classList.add('d-none');
        nameInput.value = document.getElementById('absender').value || '';
        kontoSelect.value = '';
        zahlungsartSelect.value = 'ueberweisung';
        ibanInput.value = '';
        ibanSichtbarkeit();
        if (window.SearchableSelect) window.SearchableSelect.refresh(kontoSelect);
      });

      document.getElementById('neuer-lieferant-speichern').addEventListener('click', function () {
        var speichern = this;
        if (speichern.getAttribute('aria-busy') === 'true') return;
        var name = nameInput.value.trim();
        errorBox.classList.add('d-none');
        Portal.beschaeftigt(speichern, fetch('/kontierung/lieferanten', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-CSRF-Token': '<%= locals.csrfToken || '' %>' },
          body: 'name=' + encodeURIComponent(name) + '&kontoId=' + encodeURIComponent(kontoSelect.value)
            + '&zahlungsart=' + encodeURIComponent(zahlungsartSelect.value) + '&iban=' + encodeURIComponent(ibanInput.value),
        }))
          .then(function (res) {
            return res.json().then(function (data) { return { ok: res.ok, data: data }; });
          })
          .then(function (result) {
            if (!result.ok) {
              errorBox.textContent = result.data.error || 'Lieferant konnte nicht angelegt werden.';
              errorBox.classList.remove('d-none');
              return;
            }
            var option = document.createElement('option');
            option.value = result.data.id;
            option.textContent = result.data.name;
            // Gleiche Zahlungsart wie im Dialog gewählt: steuert den IBAN-Kasten (kontierung-iban.js).
            option.setAttribute('data-iban-pflicht', zahlungsartSelect.value === 'ueberweisung' || zahlungsartSelect.value === 'dauerauftrag' ? '1' : '0');
            option.selected = true;
            kreditorSelect.appendChild(option);
            kreditorSelect.value = String(result.data.id);
            if (window.SearchableSelect) window.SearchableSelect.refresh(kreditorSelect);
            kreditorSelect.dispatchEvent(new Event('change', { bubbles: true }));
            bootstrap.Modal.getOrCreateInstance(modal).hide();
          })
          .catch(function () {
            errorBox.textContent = 'Lieferant konnte nicht angelegt werden.';
            errorBox.classList.remove('d-none');
          });
      });
    })();
  </script>
<%- include('_seite_ende') %>
