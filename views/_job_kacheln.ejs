<% /* Kachel-Gegenstück zu _job_table.ejs (gleiche Parameter). Jede Kachel zeigt alle Angaben der
     Tabellenzeile; die Aktionen kommen aus demselben Partial _job_aktionen. Callers include this only
     when jobs.length > 0. */ %>
<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-3">
  <% jobs.forEach((job) => { %>
    <div class="col">
      <% const _klickbar = !(typeof istPoolArtig !== 'undefined' && istPoolArtig); %>
      <div class="kachel d-flex flex-column gap-2<%= _klickbar ? ' position-relative kachel-klickbar' : '' %>" id="<%= idPrefix %>-kachel-<%= job.id %>" data-job-container>
        <% if (job.thumbnail_pfad) { %>
          <a href="/downloads/<%= job.id %>/oeffnen" target="_blank" rel="noopener" class="thumbnail-link d-block<%= _klickbar ? ' position-relative z-2' : '' %>" aria-label="PDF öffnen: <%- include('_beleg_name', { job }) %>"><img class="thumbnail-preview pdf-preview kachel-vorschau rounded" src="/downloads/<%= job.id %>/thumbnail" data-job-id="<%= job.id %>" data-preview-url="<%= job.previewUrl %>" alt="Vorschau"></a>
        <% } else { %>
          <div class="thumbnail-placeholder kachel-vorschau-leer text-muted small">Keine Vorschau</div>
        <% } %>
        <% /* Wie die Tabelle (_job_table.ejs): Lieferant als Titel; ohne bekannten Lieferanten der Absender klein und grau als
             einziger Hinweis auf die Herkunft. Eine eigene Absender-Zeile gibt es nicht. */ %>
        <% const _lieferant = job.vorab?.lieferant ?? { wert: job.lieferant }; %>
        <div class="fw-semibold text-break"><% if (_lieferant.wert || !job.absender) { %><%- include('_vorab_wert', { angabe: _lieferant }) %><% } else { %><small class="text-body-secondary text-break" title="Absender"><%= job.absender %></small><% } %> <%- include('_kommentar_marke', { jobId: job.id }) %></div>
        <dl class="kachel-angaben small mb-0">
          <dt>Beleg</dt><dd class="text-break"><%- include('_beleg_nr', { jobId: job.id }) %> <%- include('_beleg_name', { job }) %></dd>
          <dt>Quelle</dt><dd><%= job.quelle === 'scanner' ? 'Scanner' : job.quelle === 'spesen' ? 'Spesen' : 'Lieferant' %></dd>
          <dt>Eingang</dt><dd><%- include('_zeitpunkt', { wert: job.eingang_am }) %></dd>
          <dt>Konto</dt><dd><%= job.kontonummer || (job.hinweisKonto ? `Hinweis: ${job.hinweisKonto.kontonummer} — ${job.hinweisKonto.bezeichnung}` : '—') %></dd>
          <dt>Rechnungsnr.</dt><dd class="text-break"><%- include('_vorab_wert', { angabe: (job.vorab?.rechnungsnummer ?? { wert: job.rechnungsnummer }) }) %></dd>
          <dt>Betrag</dt><dd class="betrag"><%- include('_vorab_wert', { angabe: (job.vorab?.betrag ?? { wert: job.betrag }) }) %></dd>
        </dl>
        <div class="mt-auto d-flex flex-wrap gap-1 align-items-start">
          <%- include('_job_aktionen', { job, kachelAnsicht: true }) %>
        </div>
      </div>
    </div>
  <% }) %>
</div>
