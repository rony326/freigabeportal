<!DOCTYPE html>
<html lang="de"<% if (branding.themeAttr) { %> data-theme="<%= branding.themeAttr %>" data-bs-theme="<%= branding.bsThemeAttr %>"<% } %>>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="/vendor/bootstrap/bootstrap.min.css">
  <title>Kontierung — Freigabeportal</title>
</head>
<body>
  <%- include('_header') %>
  <main class="container-fluid py-4">
    <div class="row g-3 justify-content-center">
      <div class="col-lg-12 col-xl-10">
        <h1 class="h3">Kontierung: <%= job.dateiname %></h1>
        <p class="text-muted">Vorgangsnummer: <%= job.id %> · Quelle: <%= job.quelle === 'scanner' ? 'Scanner' : 'Lieferant' %></p>
      </div>
      <div class="w-100"></div>
      <div class="col-lg-6">
        <iframe id="kontierung-preview-frame" data-preview-url="<%= previewUrl %>" src="" class="w-100 rounded pdf-preview" style="height:85vh"></iframe>
      </div>
      <div class="col-lg-6 col-xl-4">
        <div class="card">
          <div class="card-body">
            <% if (errors.length > 0) { %>
              <div class="alert alert-danger">
                <ul class="mb-0"><% errors.forEach((error) => { %><li><%= error %></li><% }) %></ul>
              </div>
            <% } %>

            <form method="post" action="/kontierung/<%= job.id %>">
              <div class="mb-3">
                <label class="form-label" for="kontoId">Konto</label>
                <select class="form-select" id="kontoId" name="kontoId" required>
                  <option value="">— wählen —</option>
                  <% konten.forEach((k) => { %>
                    <option value="<%= k.id %>" <%= String(k.id) === values.kontoId ? 'selected' : '' %>><%= k.kontonummer %> — <%= k.bezeichnung %></option>
                  <% }) %>
                </select>
              </div>

              <div class="row g-2 mb-3">
                <div class="col-6">
                  <label class="form-label" for="absender">Absender</label>
                  <input type="text" class="form-control" id="absender" name="absender" value="<%= values.absender || '' %>">
                </div>
                <div class="col-6">
                  <label class="form-label" for="debitorId">Lieferant</label>
                  <select class="form-select" id="debitorId" name="debitorId">
                    <option value="">— wählen —</option>
                    <% debitoren.forEach((d) => { %>
                      <option value="<%= d.id %>" <%= String(d.id) === values.debitorId ? 'selected' : '' %>><%= d.name %></option>
                    <% }) %>
                  </select>
                </div>
              </div>

              <div class="mb-3">
                <label class="form-label" for="rechnungsnummer">Rechnungsnummer</label>
                <input type="text" class="form-control" id="rechnungsnummer" name="rechnungsnummer" value="<%= values.rechnungsnummer || '' %>">
              </div>

              <div class="row g-2 mb-3">
                <div class="col-6">
                  <label class="form-label" for="betrag">Betrag</label>
                  <input type="text" inputmode="decimal" class="form-control" id="betrag" name="betrag" value="<%= values.betrag || '' %>" placeholder="z.B. 123.45">
                </div>
                <div class="col-6">
                  <label class="form-label" for="zahlungsziel">Zahlungsziel</label>
                  <input type="date" class="form-control" id="zahlungsziel" name="zahlungsziel" value="<%= values.zahlungsziel || '' %>">
                </div>
              </div>

              <div class="mb-3">
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="interessenskonflikt" id="konfliktNein" value="nein" <%= values.interessenskonflikt !== 'ja' ? 'checked' : '' %>>
                  <label class="form-check-label" for="konfliktNein">Kein Interessenskonflikt</label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="interessenskonflikt" id="konfliktJa" value="ja" <%= values.interessenskonflikt === 'ja' ? 'checked' : '' %>>
                  <label class="form-check-label" for="konfliktJa">Interessenskonflikt</label>
                </div>
              </div>

              <div class="mb-3">
                <label class="form-label" for="begruendung">Begründung <span class="text-muted">(bei Interessenskonflikt oder Ablehnung Pflicht)</span></label>
                <textarea class="form-control" id="begruendung" name="begruendung"><%= values.begruendung || '' %></textarea>
              </div>

              <div class="d-flex gap-2">
                <button type="submit" name="aktion" value="kontieren" class="btn btn-primary btn-sm">Kontieren</button>
                <button type="submit" name="aktion" value="ablehnen" id="ablehnen-btn" class="btn btn-outline-danger btn-sm">Ablehnen</button>
              </div>
            </form>

            <form method="post" action="/kontierung/<%= job.id %>/zurueck-in-pool" class="mt-3">
              <button type="submit" class="btn btn-outline-secondary">Zurück in den Pool legen</button>
            </form>

            <a href="/kontierung/<%= job.id %>/aufsplitten" class="btn btn-outline-secondary mt-2">Rechnung aufsplitten</a>
          </div>
        </div>
        <%- include('_audit_log') %>
      </div>
    </div>
  </main>
  <script>
    // See pool.ejs's thumbnail-click handler for why file= must be resolved to an absolute URL.
    (function () {
      var frame = document.getElementById('kontierung-preview-frame');
      var absoluteUrl = new URL(frame.dataset.previewUrl, window.location.origin).href;
      frame.src = '/vendor/pdfjs/web/viewer.html?file=' + encodeURIComponent(absoluteUrl);
    })();
    // Ablehnen deliberately needs no Konto (the server-side handler skips that check for
    // aktion=ablehnen) — but the Konto <select>'s HTML `required` attribute is enforced by the
    // browser before the form is even submitted, regardless of which button triggered it. Drop
    // it the moment Ablehnen is clicked so the browser lets an empty Konto through; a fresh page
    // load (any validation error re-renders the page) restores the attribute from the template.
    document.getElementById('ablehnen-btn').addEventListener('click', function () {
      document.getElementById('kontoId').required = false;
    });
  </script>
  <%- include('_footer') %>
</body>
</html>
