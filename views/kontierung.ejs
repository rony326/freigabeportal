<!DOCTYPE html>
<html lang="de"<% if (branding.themeAttr) { %> data-theme="<%= branding.themeAttr %>" data-bs-theme="<%= branding.bsThemeAttr %>"<% } %>>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="/vendor/bootstrap/bootstrap.min.css">
  <title>Kontierung — <%= branding.seitenTitel %></title>
</head>
<body>
  <%- include('_header') %>
  <main class="container-fluid py-4">
    <div class="row g-3 justify-content-center">
      <div class="col-lg-12 col-xl-10">
        <h1 class="h3">Kontierung: <%= job.dateiname %></h1>
        <p class="text-muted">Vorgangsnummer: <%= job.id %> · Quelle: <%= job.quelle === 'scanner' ? 'Scanner' : 'Lieferant' %></p>
      </div>
      <div class="w-100"></div>
      <div class="col-lg-6">
        <iframe id="kontierung-preview-frame" data-preview-url="<%= previewUrl %>" src="" class="w-100 rounded pdf-preview" style="height:85vh"></iframe>
      </div>
      <div class="col-lg-6 col-xl-4">
        <div class="card">
          <div class="card-body">
            <% if (errors.length > 0) { %>
              <div class="alert alert-danger">
                <ul class="mb-0"><% errors.forEach((error) => { %><li><%= error %></li><% }) %></ul>
              </div>
            <% } %>

            <form id="kontierung-form" method="post" action="/kontierung/<%= job.id %>">
              <div class="mb-3">
                <label class="form-label" for="kontoId">Konto</label>
                <select class="form-select" id="kontoId" name="kontoId" required data-searchable>
                  <option value="">— wählen —</option>
                  <% konten.forEach((k) => { %>
                    <option value="<%= k.id %>" <%= String(k.id) === values.kontoId ? 'selected' : '' %>><%= k.kontonummer %> — <%= k.bezeichnung %></option>
                  <% }) %>
                </select>
              </div>

              <div class="row g-2 mb-3">
                <div class="col-6">
                  <label class="form-label" for="absender">Absender</label>
                  <input type="text" class="form-control" id="absender" name="absender" value="<%= values.absender || '' %>">
                </div>
                <div class="col-6">
                  <div class="d-flex justify-content-between align-items-baseline">
                    <label class="form-label mb-0" for="debitorId">Lieferant</label>
                    <button type="button" class="btn btn-link btn-sm p-0" id="neuer-lieferant-btn" data-bs-toggle="modal" data-bs-target="#neuer-lieferant-modal">+ Neu</button>
                  </div>
                  <select class="form-select" id="debitorId" name="debitorId" data-searchable>
                    <option value="">— wählen —</option>
                    <% debitoren.forEach((d) => { %>
                      <option value="<%= d.id %>" <%= String(d.id) === values.debitorId ? 'selected' : '' %>><%= d.name %></option>
                    <% }) %>
                  </select>
                </div>
              </div>

              <div class="mb-3">
                <label class="form-label" for="rechnungsnummer">Rechnungsnummer</label>
                <input type="text" class="form-control" id="rechnungsnummer" name="rechnungsnummer" value="<%= values.rechnungsnummer || '' %>">
              </div>

              <div class="row g-2 mb-3">
                <div class="col-6">
                  <label class="form-label" for="betrag">Betrag</label>
                  <input type="text" inputmode="decimal" class="form-control" id="betrag" name="betrag" value="<%= values.betrag || '' %>" placeholder="z.B. 123.45">
                </div>
                <div class="col-6">
                  <label class="form-label" for="zahlungsziel">Zahlungsziel</label>
                  <input type="date" class="form-control" id="zahlungsziel" name="zahlungsziel" value="<%= values.zahlungsziel || '' %>">
                </div>
              </div>

              <div class="mb-3">
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="interessenskonflikt" id="konfliktNein" value="nein" <%= values.interessenskonflikt !== 'ja' ? 'checked' : '' %>>
                  <label class="form-check-label" for="konfliktNein">Kein Interessenskonflikt</label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="interessenskonflikt" id="konfliktJa" value="ja" <%= values.interessenskonflikt === 'ja' ? 'checked' : '' %>>
                  <label class="form-check-label" for="konfliktJa">Interessenskonflikt</label>
                </div>
              </div>

              <div class="mb-3">
                <label class="form-label" for="begruendung">Begründung <span class="text-muted">(bei Interessenskonflikt oder Ablehnung Pflicht)</span></label>
                <textarea class="form-control" id="begruendung" name="begruendung"><%= values.begruendung || '' %></textarea>
              </div>

            </form>
            <form id="zurueck-in-pool-form" method="post" action="/kontierung/<%= job.id %>/zurueck-in-pool"></form>

            <div class="d-flex flex-wrap gap-2">
              <button type="submit" form="kontierung-form" name="aktion" value="kontieren" class="btn btn-primary btn-sm">Kontieren</button>
              <button type="submit" form="kontierung-form" name="aktion" value="ablehnen" id="ablehnen-btn" class="btn btn-outline-danger btn-sm">Ablehnen</button>
              <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#zurueck-in-pool-modal">Zurück in den Pool legen</button>
              <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#aufsplitten-modal">Rechnung aufsplitten</button>
            </div>
          </div>
        </div>
        <%- include('_audit_log') %>
      </div>
    </div>

    <div class="modal fade" id="aufsplitten-modal" tabindex="-1" aria-labelledby="aufsplitten-modal-label" aria-hidden="true">
      <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="aufsplitten-modal-label">Rechnung aufsplitten</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schließen"></button>
          </div>
          <div class="modal-body p-0">
            <iframe id="aufsplitten-frame" title="Rechnung aufsplitten" style="width:100%;height:70vh;border:0"></iframe>
          </div>
        </div>
      </div>
    </div>

    <div class="modal fade" id="zurueck-in-pool-modal" tabindex="-1" aria-labelledby="zurueck-in-pool-modal-label" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="zurueck-in-pool-modal-label">Zurück in den Pool legen</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schließen"></button>
          </div>
          <div class="modal-body">
            <div class="mb-3">
              <label class="form-label" for="hinweisKontoId">Für welches Konto ist diese Rechnung vermutlich bestimmt? <span class="text-muted">(optional)</span></label>
              <select class="form-select" id="hinweisKontoId" name="hinweisKontoId" form="zurueck-in-pool-form" data-searchable>
                <option value="">— kein Hinweis —</option>
                <% alleKonten.forEach((k) => { %>
                  <option value="<%= k.id %>"><%= k.kontonummer %> — <%= k.bezeichnung %></option>
                <% }) %>
              </select>
              <div class="form-text">Hilft der zuständigen Person, die Rechnung im Pool zu finden — sie bekommt eine E-Mail.</div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Abbrechen</button>
            <button type="submit" form="zurueck-in-pool-form" class="btn btn-primary">Zurück in den Pool legen</button>
          </div>
        </div>
      </div>
    </div>

    <div class="modal fade" id="neuer-lieferant-modal" tabindex="-1" aria-labelledby="neuer-lieferant-modal-label" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="neuer-lieferant-modal-label">Neuen Lieferanten anlegen</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schließen"></button>
          </div>
          <div class="modal-body">
            <div id="neuer-lieferant-error" class="alert alert-danger d-none"></div>
            <div class="mb-3">
              <label class="form-label" for="neuer-lieferant-name">Name</label>
              <input type="text" class="form-control" id="neuer-lieferant-name">
            </div>
            <div class="mb-3">
              <label class="form-label" for="neuer-lieferant-konto">Konto (optional)</label>
              <select class="form-select" id="neuer-lieferant-konto" data-searchable>
                <option value="">— kein Konto —</option>
                <% konten.forEach((k) => { %>
                  <option value="<%= k.id %>"><%= k.kontonummer %> — <%= k.bezeichnung %></option>
                <% }) %>
              </select>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Abbrechen</button>
            <button type="button" class="btn btn-primary" id="neuer-lieferant-speichern">Anlegen</button>
          </div>
        </div>
      </div>
    </div>
  </main>
  <script>
    // See pool.ejs's thumbnail-click handler for why file= must be resolved to an absolute URL.
    (function () {
      var frame = document.getElementById('kontierung-preview-frame');
      function ladeVorschau() {
        var absoluteUrl = new URL(frame.dataset.previewUrl, window.location.origin).href;
        frame.src = '/vendor/pdfjs/web/viewer.html?file=' + encodeURIComponent(absoluteUrl);
      }
      ladeVorschau();
      // Signed preview links are short-lived (see PDF_PREVIEW_TTL_SECONDS) — if this page has
      // been open longer than that, the embedded PDF stops loading with no obvious way to
      // recover short of a full reload. This button re-authorizes the session and mints a fresh
      // link instead.
      document.getElementById('preview-refresh-btn').addEventListener('click', function () {
        fetch('/downloads/<%= job.id %>/refresh-url')
          .then(function (res) { return res.ok ? res.json() : Promise.reject(); })
          .then(function (data) {
            frame.dataset.previewUrl = data.url;
            ladeVorschau();
          })
          .catch(function () {
            alert('Vorschau konnte nicht neu geladen werden.');
          });
      });
    })();
    // Ablehnen deliberately needs no Konto (the server-side handler skips that check for
    // aktion=ablehnen) — but the Konto <select>'s HTML `required` attribute is enforced by the
    // browser before the form is even submitted, regardless of which button triggered it. Drop
    // it the moment Ablehnen is clicked so the browser lets an empty Konto through; a fresh page
    // load (any validation error re-renders the page) restores the attribute from the template.
    document.getElementById('ablehnen-btn').addEventListener('click', function () {
      document.getElementById('kontoId').required = false;
    });
    // "Rechnung aufsplitten" opens the existing standalone split page inside a Bootstrap modal via
    // an <iframe>, rather than navigating away — the page itself is unchanged (still a normal
    // GET/POST form) so error re-renders just update in place inside the modal. Two things need
    // JS glue because the split route was written for full-page navigation, not an iframe: (1) the
    // frame is only pointed at the route once the modal is actually opened, so it isn't fetched on
    // every Kontierung page load; (2) a successful split redirects to /pool server-side, which
    // would otherwise load /pool squeezed inside the small iframe — the load handler below detects
    // that and breaks the redirect out to the top-level window instead.
    (function () {
      var modal = document.getElementById('aufsplitten-modal');
      var frame = document.getElementById('aufsplitten-frame');
      var frameUrl = '/kontierung/<%= job.id %>/aufsplitten';
      var geladen = false;
      modal.addEventListener('shown.bs.modal', function () {
        if (!geladen) {
          geladen = true;
          frame.src = frameUrl;
        }
      });
      frame.addEventListener('load', function () {
        try {
          if (frame.contentWindow.location.pathname === '/pool') {
            window.location.href = '/pool';
          }
        } catch (e) {
          // Same-origin by construction; nothing to do if the browser disagrees.
        }
      });
      // The split page's "Abbrechen" link can't close a modal in the parent document directly
      // (different document) — it posts a message instead, handled here.
      window.addEventListener('message', function (e) {
        if (e.origin === window.location.origin && e.data === 'aufsplitten-abbrechen') {
          bootstrap.Modal.getOrCreateInstance(modal).hide();
        }
      });
    })();
    // Progressively enhances any <select data-searchable> into a filterable combobox: a text
    // input the person can type into to narrow the list, backed by the original <select> as the
    // single source of truth for value/name/required (kept in the DOM, just visually hidden via
    // .visually-hidden rather than .d-none — a display:none form control is excluded from HTML5
    // constraint validation in every major browser, which would silently defeat the Konto
    // select's `required` and break the existing Ablehnen/Kontieren required-toggle above). No
    // "required" is ever set on the shadow input itself, so it never validates independently of
    // the real select.
    (function () {
      function optionLabel(opt) {
        return opt.textContent;
      }

      function enhance(select) {
        if (select.dataset.searchableEnhanced) return;
        select.dataset.searchableEnhanced = '1';

        var wrapper = document.createElement('div');
        wrapper.className = 'position-relative';
        select.parentNode.insertBefore(wrapper, select);

        var input = document.createElement('input');
        input.type = 'text';
        input.className = select.className;
        input.setAttribute('autocomplete', 'off');
        input.setAttribute('role', 'combobox');
        input.setAttribute('aria-expanded', 'false');
        if (select.disabled) input.disabled = true;
        var placeholderOption = select.querySelector('option[value=""]');
        if (placeholderOption) input.placeholder = placeholderOption.textContent;

        wrapper.appendChild(input);
        wrapper.appendChild(select);
        select.classList.add('visually-hidden');

        var menu = document.createElement('div');
        menu.className = 'list-group position-absolute w-100 shadow-sm d-none';
        menu.style.zIndex = '1000';
        menu.style.maxHeight = '240px';
        menu.style.overflowY = 'auto';
        wrapper.appendChild(menu);

        var activeIndex = -1;

        function currentSelectedLabel() {
          var opt = select.options[select.selectedIndex];
          return opt && opt.value ? optionLabel(opt) : '';
        }

        function syncInputFromSelect() {
          input.value = currentSelectedLabel();
        }

        function highlight(items) {
          Array.prototype.forEach.call(items, function (item, i) {
            item.classList.toggle('active', i === activeIndex);
          });
          if (items[activeIndex]) items[activeIndex].scrollIntoView({ block: 'nearest' });
        }

        function renderMenu(filterText) {
          menu.innerHTML = '';
          activeIndex = -1;
          var lower = (filterText || '').toLowerCase();
          var any = false;
          Array.prototype.forEach.call(select.options, function (opt) {
            if (!opt.value) return; // skip the "— wählen —" placeholder
            var label = optionLabel(opt);
            if (lower && label.toLowerCase().indexOf(lower) === -1) return;
            any = true;
            var item = document.createElement('button');
            item.type = 'button';
            item.className = 'list-group-item list-group-item-action py-1';
            item.textContent = label;
            item.dataset.value = opt.value;
            // mousedown (not click) fires before the input's blur handler hides the menu.
            item.addEventListener('mousedown', function (e) {
              e.preventDefault();
              select.value = opt.value;
              syncInputFromSelect();
              hideMenu();
              select.dispatchEvent(new Event('change', { bubbles: true }));
            });
            menu.appendChild(item);
          });
          if (!any) {
            var empty = document.createElement('div');
            empty.className = 'list-group-item text-muted py-1';
            empty.textContent = 'Keine Treffer';
            menu.appendChild(empty);
          }
        }

        function showMenu() {
          renderMenu(input.value === currentSelectedLabel() ? '' : input.value);
          menu.classList.remove('d-none');
          input.setAttribute('aria-expanded', 'true');
        }

        function hideMenu() {
          menu.classList.add('d-none');
          input.setAttribute('aria-expanded', 'false');
        }

        input.addEventListener('focus', showMenu);
        input.addEventListener('input', function () {
          renderMenu(input.value);
          menu.classList.remove('d-none');
        });
        input.addEventListener('blur', function () {
          // Delayed so the menu item's mousedown handler above still fires first.
          setTimeout(function () {
            hideMenu();
            input.value = currentSelectedLabel();
          }, 150);
        });
        input.addEventListener('keydown', function (e) {
          if (e.key === 'ArrowDown') {
            e.preventDefault();
            if (menu.classList.contains('d-none')) {
              showMenu();
              return;
            }
            var items = menu.querySelectorAll('[data-value]');
            activeIndex = Math.min(activeIndex + 1, items.length - 1);
            highlight(items);
          } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            activeIndex = Math.max(activeIndex - 1, 0);
            highlight(menu.querySelectorAll('[data-value]'));
          } else if (e.key === 'Enter') {
            var current = menu.querySelectorAll('[data-value]')[activeIndex];
            if (!menu.classList.contains('d-none') && current) {
              e.preventDefault();
              current.dispatchEvent(new MouseEvent('mousedown'));
            }
          } else if (e.key === 'Escape') {
            hideMenu();
          }
        });

        syncInputFromSelect();
      }

      function refresh(select) {
        var input = select.parentNode.querySelector('input[role="combobox"]');
        if (!input) return;
        var opt = select.options[select.selectedIndex];
        input.value = opt && opt.value ? optionLabel(opt) : '';
      }

      Array.prototype.forEach.call(document.querySelectorAll('select[data-searchable]'), enhance);
      window.SearchableSelect = { enhance: enhance, refresh: refresh };
    })();
    // "+ Neu" next to the Lieferant-Dropdown opens a modal to create a Debitor on the fly, so a
    // person doesn't have to leave the Kontierung page (and lose their in-progress form) to go
    // through /admin/debitoren just because the invoice's supplier isn't in the list yet. The Name
    // field is pre-filled from the Absender field already on this page, since that's usually
    // already the supplier's address/name lifted straight off the invoice.
    (function () {
      var modal = document.getElementById('neuer-lieferant-modal');
      var nameInput = document.getElementById('neuer-lieferant-name');
      var kontoSelect = document.getElementById('neuer-lieferant-konto');
      var errorBox = document.getElementById('neuer-lieferant-error');
      var debitorSelect = document.getElementById('debitorId');

      modal.addEventListener('show.bs.modal', function () {
        errorBox.classList.add('d-none');
        nameInput.value = document.getElementById('absender').value || '';
        kontoSelect.value = '';
        if (window.SearchableSelect) window.SearchableSelect.refresh(kontoSelect);
      });

      document.getElementById('neuer-lieferant-speichern').addEventListener('click', function () {
        var name = nameInput.value.trim();
        errorBox.classList.add('d-none');
        fetch('/kontierung/lieferanten', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: 'name=' + encodeURIComponent(name) + '&kontoId=' + encodeURIComponent(kontoSelect.value),
        })
          .then(function (res) {
            return res.json().then(function (data) { return { ok: res.ok, data: data }; });
          })
          .then(function (result) {
            if (!result.ok) {
              errorBox.textContent = result.data.error || 'Lieferant konnte nicht angelegt werden.';
              errorBox.classList.remove('d-none');
              return;
            }
            var option = document.createElement('option');
            option.value = result.data.id;
            option.textContent = result.data.name;
            option.selected = true;
            debitorSelect.appendChild(option);
            debitorSelect.value = String(result.data.id);
            if (window.SearchableSelect) window.SearchableSelect.refresh(debitorSelect);
            bootstrap.Modal.getOrCreateInstance(modal).hide();
          })
          .catch(function () {
            errorBox.textContent = 'Lieferant konnte nicht angelegt werden.';
            errorBox.classList.remove('d-none');
          });
      });
    })();
  </script>
  <%- include('_footer') %>
</body>
</html>
