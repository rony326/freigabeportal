<!DOCTYPE html>
<html lang="de"<% if (branding.themeAttr) { %> data-theme="<%= branding.themeAttr %>" data-bs-theme="<%= branding.bsThemeAttr %>"<% } %>>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="/vendor/bootstrap/bootstrap.min.css">
  <title>Erscheinungsbild — Freigabeportal Admin</title>
</head>
<body>
  <%- include('../_header') %>
  <main class="container py-4">
    <%- include('./_nav') %>
    <h1>Erscheinungsbild</h1>
    <% if (errors.length > 0) { %>
      <div class="alert alert-danger">
        <ul class="mb-0"><% errors.forEach((error) => { %><li><%= error %></li><% }) %></ul>
      </div>
    <% } %>
    <% if (hasLogo) { %>
      <p>Aktuelles Logo: <img src="/branding/logo" alt="Aktuelles Logo" height="48"></p>
    <% } %>
    <form method="post" action="/admin/erscheinungsbild" enctype="multipart/form-data" class="col-12 col-md-8 col-lg-6">
      <div class="mb-3">
        <label class="form-label" for="primaryColor">Primärfarbe</label>
        <input type="color" class="form-control form-control-color" id="primaryColor" name="primaryColor" value="<%= primaryColor %>" required>
      </div>
      <div class="mb-3">
        <label class="form-label" for="secondaryColor">Sekundärfarbe</label>
        <input type="color" class="form-control form-control-color" id="secondaryColor" name="secondaryColor" value="<%= secondaryColor %>" required>
      </div>
      <div class="mb-3">
        <label class="form-label" for="themeDefault">Standard-Farbmodus</label>
        <select class="form-select" id="themeDefault" name="themeDefault">
          <option value="system" <%= themeDefault === 'system' ? 'selected' : '' %>>Folgt Geräteeinstellung</option>
          <option value="hell" <%= themeDefault === 'hell' ? 'selected' : '' %>>Hell</option>
          <option value="dunkel" <%= themeDefault === 'dunkel' ? 'selected' : '' %>>Dunkel</option>
        </select>
      </div>
      <div class="mb-3">
        <label class="form-label" for="logo">Logo (PNG oder JPEG, max. 2 MB)</label>
        <input type="file" class="form-control" id="logo" name="logo" accept="image/png,image/jpeg">
      </div>
      <div class="mb-3">
        <label class="form-label" for="logoAusrichtung">Logo-Ausrichtung</label>
        <select class="form-select" id="logoAusrichtung" name="logoAusrichtung">
          <option value="links" <%= logoAusrichtung === 'links' ? 'selected' : '' %>>Linksbündig</option>
          <option value="mitte" <%= logoAusrichtung === 'mitte' ? 'selected' : '' %>>Mittig</option>
          <option value="rechts" <%= logoAusrichtung === 'rechts' ? 'selected' : '' %>>Rechtsbündig</option>
        </select>
      </div>
      <div class="mb-3">
        <label class="form-label" for="footerText">Footer-Text</label>
        <input type="text" class="form-control" id="footerText" name="footerText" value="<%= footerText %>" maxlength="200" placeholder="z.B. Kirchenname oder Kontakt-Mail">
        <div class="form-text">Wird im Footer als „© <%= new Date().getFullYear() %> …“ angezeigt. Leer lassen für kein Text.</div>
      </div>
      <div class="mb-3 form-check">
        <input type="checkbox" class="form-check-input" id="auditLogLokaleZeit" name="auditLogLokaleZeit" <%= auditLogLokaleZeit ? 'checked' : '' %>>
        <label class="form-check-label" for="auditLogLokaleZeit">Audit-Log-Zeiten in Lokalzeit (Europe/Zürich) anzeigen</label>
        <div class="form-text">In der Datenbank wird weiterhin UTC gespeichert — diese Einstellung wirkt sich nur auf die Anzeige im Audit-Log aus.</div>
      </div>
      <button type="submit" class="btn btn-primary">Speichern</button>
      <% if (gespeichert) { %>
        <div class="alert alert-success alert-dismissible fade show d-inline-flex align-items-center py-1 ps-2 ms-2 mb-0" role="alert">
          Gespeichert.
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Schließen"></button>
        </div>
      <% } %>
    </form>
  </main>
  <%- include('../_footer') %>
</body>
</html>
