<%
  // Bootstrap-eigene "Primärfarbe" (aktive Listeneinträge, angehakte Felder, Fokusrahmen, Nummern-Kreise)
  // folgt der Markenfarbe statt dem Standard-Blau. Bootstrap braucht dafür auch die RGB-Zahlen.
  const markeHex = /^#[0-9a-f]{6}$/i.test(branding.primaryColor || '') ? branding.primaryColor : '#2f4858';
  const markeRgb = [1, 3, 5].map((i) => parseInt(markeHex.slice(i, i + 2), 16)).join(', ');
%><style nonce="<%= locals.cspNonce %>">
  :root {
    --brand-primary: <%= branding.primaryColor || '#2f4858' %>;
    --brand-secondary: <%= branding.secondaryColor || '#4d7ea8' %>;
    --bs-primary: <%= markeHex %>;
    --bs-primary-rgb: <%= markeRgb %>;
    --bg: #ffffff;
    --fg: #1a1a1a;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="hell"]) {
      --bg: #1a1a1a;
      --fg: #f0f0f0;
    }
  }
  :root[data-theme="dunkel"] {
    --bg: #1a1a1a;
    --fg: #f0f0f0;
  }
  body { background: var(--bg); color: var(--fg); }
  a { color: var(--brand-primary); }
  /* Bootstrap's default .border is a light grey (--bs-border-color) that all but disappears
     against a light/white page background, making the PDF preview frame's edges hard to see in
     light mode. A fine border plus a soft shadow lifts the frame; in dark mode the rules below
     take over. */
  .pdf-preview {
    border: 1px solid var(--bs-border-color);
    box-shadow: 0 1px 2px rgb(0 0 0 / .08), 0 4px 12px rgb(0 0 0 / .06);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="hell"]) .pdf-preview {
      border: 1px solid var(--bs-border-color);
    }
  }
  :root[data-theme="dunkel"] .pdf-preview {
    border: 1px solid var(--bs-border-color);
  }
  /* Bootstrap's compiled CSS bakes literal hex values into each .btn-* and active-tab-link
     variant's own custom properties (not a reference to --bs-primary), so this app's
     per-instance branding colors must override those component-level variables directly to
     actually reach rendered buttons and the active tab indicator — setting --bs-primary alone
     has no effect. */
  .btn-primary {
    --bs-btn-bg: var(--brand-primary);
    --bs-btn-border-color: var(--brand-primary);
    --bs-btn-hover-bg: var(--brand-secondary);
    --bs-btn-hover-border-color: var(--brand-secondary);
    --bs-btn-active-bg: var(--brand-secondary);
    --bs-btn-active-border-color: var(--brand-secondary);
    --bs-btn-disabled-bg: var(--brand-primary);
    --bs-btn-disabled-border-color: var(--brand-primary);
  }
  .btn-outline-primary {
    --bs-btn-color: var(--brand-primary);
    --bs-btn-border-color: var(--brand-primary);
    --bs-btn-hover-bg: var(--brand-primary);
    --bs-btn-hover-border-color: var(--brand-primary);
    --bs-btn-active-bg: var(--brand-primary);
    --bs-btn-active-border-color: var(--brand-primary);
    --bs-btn-disabled-color: var(--brand-primary);
    --bs-btn-disabled-border-color: var(--brand-primary);
  }
  /* Angehakte Optionsfelder und Kontrollkästchen: Bootstrap schreibt dafür ein festes Blau. */
  .form-check-input:checked, .form-check-input[type="checkbox"]:indeterminate {
    background-color: var(--brand-primary);
    border-color: var(--brand-primary);
  }
  /* Fokus von Feldern, Auswahlfeldern und Häkchen: Bootstrap schreibt dafür ein festes Blau
     (#86b7fe / rgba(13,110,253,.25)). Hier folgt der Rahmen der Markenfarbe; im dunklen Modus wird sie
     mit Weiss aufgehellt, damit der Rahmen vor dem fast schwarzen Hintergrund sichtbar bleibt. */
  .form-control:focus, .form-select:focus, .form-check-input:focus {
    border-color: color-mix(in srgb, var(--brand-primary) 60%, #fff);
    box-shadow: 0 0 0 .25rem color-mix(in srgb, var(--brand-primary) 40%, transparent);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="hell"]) .form-control:focus, :root:not([data-theme="hell"]) .form-select:focus, :root:not([data-theme="hell"]) .form-check-input:focus {
      border-color: color-mix(in srgb, var(--brand-primary) 30%, #fff);
      box-shadow: 0 0 0 .25rem color-mix(in srgb, color-mix(in srgb, var(--brand-primary) 30%, #fff) 45%, transparent);
    }
  }
  :root[data-theme="dunkel"] .form-control:focus, :root[data-theme="dunkel"] .form-select:focus, :root[data-theme="dunkel"] .form-check-input:focus {
    border-color: color-mix(in srgb, var(--brand-primary) 30%, #fff);
    box-shadow: 0 0 0 .25rem color-mix(in srgb, color-mix(in srgb, var(--brand-primary) 30%, #fff) 45%, transparent);
  }
  /* Bootstrap's compiled .btn-outline-secondary bakes in a fixed #6c757d for text/border in
     every theme (it isn't redefined under [data-bs-theme=dark] the way body/border colors are) —
     against this app's near-black dark background that's under 3:1 contrast, well below WCAG AA.
     Same media-query/[data-theme] pairing as .pdf-preview above; light mode's contrast is fine
     already and stays untouched. */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="hell"]) .btn-outline-secondary {
      --bs-btn-color: #ced4da;
      --bs-btn-border-color: #ced4da;
      --bs-btn-hover-color: #1a1a1a;
      --bs-btn-hover-bg: #ced4da;
      --bs-btn-hover-border-color: #ced4da;
      --bs-btn-active-color: #1a1a1a;
      --bs-btn-active-bg: #ced4da;
      --bs-btn-active-border-color: #ced4da;
    }
  }
  :root[data-theme="dunkel"] .btn-outline-secondary {
    --bs-btn-color: #ced4da;
    --bs-btn-border-color: #ced4da;
    --bs-btn-hover-color: #1a1a1a;
    --bs-btn-hover-bg: #ced4da;
    --bs-btn-hover-border-color: #ced4da;
    --bs-btn-active-color: #1a1a1a;
    --bs-btn-active-bg: #ced4da;
    --bs-btn-active-border-color: #ced4da;
  }
  /* .btn-outline-primary (Beleg/Formular-Umschalter, "Speichern" bei Personen) uses the brand
     color as text — a dark brand (default #2f4858) on the near-black dark background is about
     1.6:1. In dark mode, unpressed text/border are the brand color mixed with 70 % white (always
     ≥ 8:1 against #1a1a1a, whatever the brand); hover/active keep the brand background + white. */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="hell"]) .btn-outline-primary {
      --bs-btn-color: color-mix(in srgb, var(--brand-primary) 30%, #fff);
      --bs-btn-border-color: color-mix(in srgb, var(--brand-primary) 30%, #fff);
      --bs-btn-disabled-color: color-mix(in srgb, var(--brand-primary) 30%, #fff);
      --bs-btn-disabled-border-color: color-mix(in srgb, var(--brand-primary) 30%, #fff);
    }
  }
  :root[data-theme="dunkel"] .btn-outline-primary {
    --bs-btn-color: color-mix(in srgb, var(--brand-primary) 30%, #fff);
    --bs-btn-border-color: color-mix(in srgb, var(--brand-primary) 30%, #fff);
    --bs-btn-disabled-color: color-mix(in srgb, var(--brand-primary) 30%, #fff);
    --bs-btn-disabled-border-color: color-mix(in srgb, var(--brand-primary) 30%, #fff);
  }
</style>
<style nonce="<%= locals.cspNonce %>">
  /* Scoped to only render alongside the menu itself: an anonymous visitor gets no menu at all,
     so this selector must not appear in the unconditional style block above. Bootstrap's
     .dropdown-item.active otherwise falls back to its own default blue, not this app's brand
     color — same reasoning as the .btn-primary/.btn-outline-primary overrides above. */
  .dropdown-item.active, .dropdown-item:active {
    background-color: var(--brand-primary);
  }
</style>
