<% if (jobs.length === 0) { %>
  <p>Keine eigenen Spesen-Einreichungen.</p>
<% } else { %>
  <div class="table-responsive">
    <table class="table align-middle">
      <thead><tr><th>Eingereicht am</th><th>Konto</th><th>Betrag</th><th>Verwendungszweck</th><th>Status</th><th>Zeitstempel</th><th></th></tr></thead>
      <tbody>
        <% jobs.forEach((job) => { %>
          <tr id="spesen-meine-row-<%= job.id %>">
            <td><%- include('_zeitpunkt', { wert: job.eingang_am }) %></td>
            <td><%= job.kontonummer || '—' %></td>
            <td><%= job.betrag %></td>
            <td><%= job.beschreibung %></td>
            <td>
              <%= job.status %>
              <% if (job.status === 'abgelehnt' && job.ablehnungsgrund) { %>
                — <%= job.ablehnungsgrund %>
              <% } %>
            </td>
            <td>
              <% if (['abgeschlossen', 'abgeholt', 'archiviert'].includes(job.status)) { %>
                <% if (job.zeitstempel_gesetzt_am) { %>
                  ✓ gesetzt am <%= job.zeitstempel_gesetzt_am %>
                <% } else { %>
                  ausstehend
                <% } %>
              <% } else { %>
                —
              <% } %>
            </td>
            <td><%- include('_zeitstempel_aktion', { job }) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>
