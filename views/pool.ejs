<%- include('_seite_anfang', { titel: 'Aufgaben' }) %>
<% /* Ansichtswahl (src/middleware/ansicht.js): 'tabelle', 'kacheln' oder 'auto' (unter lg Kacheln,
     sonst Tabelle — dann werden beide gerendert). Ohne Middleware (Test-Apps) gilt 'auto'. */
   const gewaehlteAnsicht = (typeof ansicht !== 'undefined' && ansicht) || 'auto';
   const jobListe = (daten) => {
     let html = '';
     if (gewaehlteAnsicht !== 'kacheln') {
       html += `<div class="ansicht-tabelle${gewaehlteAnsicht === 'auto' ? ' d-none d-lg-block' : ''}">${include('_job_table', daten)}</div>`;
     }
     if (gewaehlteAnsicht !== 'tabelle') {
       html += `<div class="ansicht-kacheln${gewaehlteAnsicht === 'auto' ? ' d-lg-none' : ''}">${include('_job_kacheln', daten)}</div>`;
     }
     return html;
   }; %>
    <div class="seitenkopf">
      <h1 class="seitenkopf-titel">Aufgaben</h1>
      <div class="seitenkopf-aktionen">
        <a href="/pool" class="btn btn-outline-secondary btn-sm" aria-label="Dashboard neu laden">🔄 Neu laden</a>
        <%- include('_ansicht_umschalter') %>
      </div>
    </div>

    <% if (typeof isBuchhaltung !== 'undefined' && (isBuchhaltung || isSuperadmin) && poolJobs.length > 0) { %>
      <h2 class="h5 mt-4">Pool</h2>
      <%- jobListe({ jobs: poolJobs, idPrefix: 'pool', istPoolArtig: true, kannZuweisen, zielPersonen }) %>
      <% if (typeof kkKarten !== 'undefined' && kkKarten.length > 0) { %>
        <form method="post" id="kk-markieren-form" class="d-flex flex-wrap gap-2 align-items-center mt-2">
          <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
          <span>Kreditkartenabrechnung:</span>
          <select class="form-select form-select-sm w-auto" id="kk-markieren-job" required>
            <option value="">— Beleg aus dem Pool —</option>
            <% poolJobs.filter((j) => !j.aufgesplittet_von).forEach((j) => { %><option value="<%= j.id %>"><%- include('_beleg_name', { job: j, mitNummer: true }) %></option><% }) %>
          </select>
          <select class="form-select form-select-sm w-auto" name="kreditkarteId" required>
            <option value="">— Karte —</option>
            <% kkKarten.forEach((k) => { %><option value="<%= k.id %>"><%= k.bezeichnung %></option><% }) %>
          </select>
          <button type="submit" class="btn btn-outline-primary btn-sm">Zum Abgleich übergeben</button>
        </form>
        <script>
          document.getElementById('kk-markieren-form').addEventListener('submit', function (e) {
            var id = document.getElementById('kk-markieren-job').value;
            if (!id) { e.preventDefault(); return; }
            this.action = '/pool/' + encodeURIComponent(id) + '/als-kk-abrechnung';
          });
        </script>
      <% } %>
    <% } %>

    <% if (typeof kannZuweisen !== 'undefined' && kannZuweisen && ruecklaeufer.length > 0) { %>
      <h2 class="h5 mt-4">Rückläufer</h2>
      <%- jobListe({ jobs: ruecklaeufer, idPrefix: 'ruecklaeufer', istPoolArtig: true, kannZuweisen, zielPersonen }) %>
    <% } %>

    <% if (typeof isSuperadmin !== 'undefined' && isSuperadmin) { %>
      <% if (adminEskalierteKontierungen.length > 0) { %>
        <h2 class="h5 mt-4">An Superadmin eskalierte Kontierungen</h2>
        <%- jobListe({ jobs: adminEskalierteKontierungen, idPrefix: 'admin-eskalation-kontierung', linkPrefix: '/kontierung', aktionLabel: 'Kontieren' }) %>
      <% } %>

      <% if (adminEskalierteFreigaben.length > 0) { %>
        <h2 class="h5 mt-4">An Superadmin eskalierte Freigaben</h2>
        <%- jobListe({ jobs: adminEskalierteFreigaben, idPrefix: 'admin-eskalation-freigabe', linkPrefix: '/freigabe2', aktionLabel: 'Freigeben' }) %>
      <% } %>

      <% if (adminEskalierteSpesenFreigaben.length > 0) { %>
        <h2 class="h5 mt-4">An Superadmin eskalierte Spesen-Freigaben</h2>
        <%- jobListe({ jobs: adminEskalierteSpesenFreigaben, idPrefix: 'admin-eskalation-spesen-freigabe', linkPrefix: '/spesen-freigabe1', aktionLabel: 'Prüfen' }) %>
      <% } %>
    <% } %>

    <% if (meineKontierungen.length > 0) { %>
      <h2 class="h5 mt-4">Meine offenen Kontierungen</h2>
      <%- jobListe({ jobs: meineKontierungen, idPrefix: 'kontierung', linkPrefix: '/kontierung', aktionLabel: 'Kontieren' }) %>
    <% } %>

    <% if (meineSpesenFreigaben.length > 0) { %>
      <h2 class="h5 mt-4">Meine offenen Spesen-Freigaben</h2>
      <%- jobListe({ jobs: meineSpesenFreigaben, idPrefix: 'spesen-freigabe1', linkPrefix: '/spesen-freigabe1', aktionLabel: 'Prüfen' }) %>
    <% } %>

    <% if (meineFreigaben.length > 0) { %>
      <h2 class="h5 mt-4">Meine Freigaben</h2>
      <%- jobListe({ jobs: meineFreigaben, idPrefix: 'freigabe2', linkPrefix: '/freigabe2', aktionLabel: 'Freigeben' }) %>
    <% } %>

    <% if (meineAbgelehnten.length > 0) { %>
      <h2 class="h5 mt-4">Meine abgelehnten Jobs</h2>
      <%- jobListe({ jobs: meineAbgelehnten, idPrefix: 'abgelehnt', linkPrefix: '/abgelehnt', aktionLabel: 'Ansehen' }) %>
    <% } %>

    <% if (poolJobs.length === 0 && ruecklaeufer.length === 0 && adminEskalierteKontierungen.length === 0 && adminEskalierteFreigaben.length === 0
         && adminEskalierteSpesenFreigaben.length === 0 && meineKontierungen.length === 0 && meineSpesenFreigaben.length === 0
         && meineFreigaben.length === 0 && meineAbgelehnten.length === 0) { %>
      <p class="text-muted mt-4">Keine offenen Aufgaben. Abgeschlossene Rechnungen findest du unter <a href="/meine-abgeschlossenen">Abgeschlossene Rechnungen</a>, deine Spesen-Einreichungen unter <a href="/meine-spesen">Meine Spesen</a>.</p>
    <% } %>

    <dialog id="preview-dialog" class="p-0 border-0 rounded">
      <div class="d-flex justify-content-end p-2 bg-body border-bottom">
        <button type="button" id="preview-dialog-close" class="btn btn-outline-secondary btn-sm">Schließen</button>
      </div>
      <iframe id="preview-frame" src="" class="pdf-preview" style="width:80vw;height:80vh"></iframe>
    </dialog>

  <script>
    document.querySelectorAll('.beanspruchen-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.dataset.jobId;
        const res = await fetch(`/api/pool/${id}/beanspruchen`, { method: 'POST', headers: { 'X-CSRF-Token': '<%= locals.csrfToken || '' %>' } });
        if (res.ok) {
          window.location.href = `/kontierung/${id}`;
          return;
        }
        const body = await res.json().catch(() => ({}));
        // Use the button's own container (table row or tile) rather than reconstructing an id:
        // the button appears in the Pool and Rückläufer sections, each as row and as tile.
        const container = btn.closest('[data-job-container]');
        if (container) {
          const text = body.error || 'Job ist nicht mehr verfügbar.';
          let msg;
          if (container.tagName === 'TR') {
            msg = document.createElement('tr');
            const cell = document.createElement('td');
            cell.colSpan = container.children.length;
            cell.textContent = text;
            msg.appendChild(cell);
          } else {
            msg = document.createElement('div');
            msg.className = 'kachel text-muted';
            msg.textContent = text;
          }
          container.replaceWith(msg);
        }
      });
    });

    document.querySelectorAll('.zuweisen-form').forEach((form) => {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const id = form.dataset.jobId;
        const personId = form.querySelector('select[name="personId"]').value;
        const res = await fetch(`/pool/${id}/zuweisen`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-CSRF-Token': '<%= locals.csrfToken || '' %>' },
          body: new URLSearchParams({ personId }),
        });
        if (res.ok) {
          window.location.reload();
          return;
        }
        const body = await res.json().catch(() => ({}));
        alert(body.error || 'Zuweisung fehlgeschlagen.');
      });
    });

    function oeffneVorschau(relativeUrl) {
      // Rendered via PDF.js (public/vendor/pdfjs), not the browser's native PDF plugin:
      // Chrome's "Download PDFs instead of automatically opening them" setting blocks native
      // inline rendering inside an <iframe> entirely (shows an Open-button placeholder that
      // downloads instead of previewing), regardless of Content-Disposition. PDF.js renders
      // via canvas/JS and is unaffected by that setting.
      // The file= value must be an absolute URL: PDF.js's viewer runs `new URL(file)` with no
      // base, which throws for a relative path like ours — its fallback then treats the whole
      // string (query string included) as a literal filename, so expires/signature never reach
      // the server as real query params and every preview 403s. Resolving against
      // location.origin here keeps it a real, absolute, still-relative-to-this-host URL.
      const absoluteUrl = new URL(relativeUrl, window.location.origin).href;
      document.getElementById('preview-frame').src = '/vendor/pdfjs/web/viewer.html?file=' + encodeURIComponent(absoluteUrl);
      document.getElementById('preview-dialog').showModal();
    }

    // Handler am Link (nicht am Bild): so öffnet auch Enter auf dem fokussierten Link den Dialog.
    document.querySelectorAll('.thumbnail-link').forEach((link) => {
      const img = link.querySelector('.thumbnail-preview');
      if (!img) return;
      link.addEventListener('click', (event) => {
        // Unter 992 px (Handy/Tablet) kein Dialog mit eingebettetem PDF — iOS/iPadOS scrollen
        // eingebettete PDFs nicht zuverlässig: der umgebende Link öffnet das PDF im neuen Tab
        // (/downloads/:id/oeffnen signiert bei jedem Klick frisch). Ab 992 px wie bisher.
        if (!window.matchMedia('(min-width: 992px)').matches) return;
        event.preventDefault();
        // The preview URL baked into the page at render time may already have expired if the
        // dashboard has been open for a while (signed links are short-lived, see
        // PDF_PREVIEW_TTL_SECONDS) — fetch a freshly-signed one for this click instead of
        // reusing the stale one, falling back to it only if the refresh itself fails.
        fetch(`/downloads/${img.dataset.jobId}/refresh-url`)
          .then((res) => (res.ok ? res.json() : Promise.reject()))
          .then((data) => oeffneVorschau(data.url))
          .catch(() => oeffneVorschau(img.dataset.previewUrl));
      });
    });
    document.getElementById('preview-dialog-close').addEventListener('click', () => {
      document.getElementById('preview-dialog').close();
      document.getElementById('preview-frame').src = '';
    });
  </script>
<%- include('_seite_ende') %>
