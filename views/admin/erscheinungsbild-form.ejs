<%- include('../_seite_anfang', { titel: 'Erscheinungsbild' }) %>
    <div class="seitenkopf">
      <h1 class="seitenkopf-titel">Erscheinungsbild</h1>
    </div>
    <% if (errors.length > 0) { %>
      <div class="alert alert-danger">
        <ul class="mb-0"><% errors.forEach((error) => { %><li><%= error %></li><% }) %></ul>
      </div>
    <% } %>
    <% if (hasLogo || (typeof hasLogoDunkel !== 'undefined' && hasLogoDunkel)) { %>
      <div class="d-flex flex-wrap gap-3 mb-3">
        <% if (hasLogo) { %>
          <div class="border rounded p-2 bg-white text-dark">
            <div class="small mb-1">Logo hell</div>
            <img src="<%= branding.logoUrl || '/branding/logo' %>" alt="Aktuelles Logo hell" height="48">
          </div>
        <% } %>
        <% if (typeof hasLogoDunkel !== 'undefined' && hasLogoDunkel) { %>
          <div class="border rounded p-2 bg-dark text-white">
            <div class="small mb-1">Logo dunkel</div>
            <img src="<%= branding.logoDunkelUrl || '/branding/logo-dunkel' %>" alt="Aktuelles Logo dunkel" height="48">
          </div>
        <% } %>
      </div>
    <% } %>
    <form method="post" action="/admin/erscheinungsbild" enctype="multipart/form-data" class="col-12 col-md-8 col-lg-6">
      <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
      <div class="mb-3">
        <label class="form-label" for="primaryColor">Primärfarbe</label>
        <input type="color" class="form-control form-control-color" id="primaryColor" name="primaryColor" value="<%= primaryColor %>" required>
      </div>
      <div class="mb-3">
        <label class="form-label" for="secondaryColor">Sekundärfarbe</label>
        <input type="color" class="form-control form-control-color" id="secondaryColor" name="secondaryColor" value="<%= secondaryColor %>" required>
      </div>
      <div class="mb-3">
        <label class="form-label" for="themeDefault">Standard-Farbmodus</label>
        <select class="form-select" id="themeDefault" name="themeDefault">
          <option value="system" <%= themeDefault === 'system' ? 'selected' : '' %>>Folgt Geräteeinstellung</option>
          <option value="hell" <%= themeDefault === 'hell' ? 'selected' : '' %>>Hell</option>
          <option value="dunkel" <%= themeDefault === 'dunkel' ? 'selected' : '' %>>Dunkel</option>
        </select>
      </div>
      <div class="mb-3">
        <label class="form-label" for="logo">Logo hell (PNG oder JPEG, max. 2 MB)</label>
        <input type="file" class="form-control" id="logo" name="logo" accept="image/png,image/jpeg">
        <div class="form-text">Wird im hellen Farbmodus und auf der gedruckten Prüfbescheinigung verwendet.</div>
      </div>
      <div class="mb-3">
        <label class="form-label" for="logoDunkel">Logo dunkel (optional, PNG oder JPEG, max. 2 MB)</label>
        <input type="file" class="form-control" id="logoDunkel" name="logoDunkel" accept="image/png,image/jpeg">
        <div class="form-text">Wird im Dunkelmodus angezeigt. Ohne dunkles Logo erscheint auch dort das helle.</div>
        <% if (typeof hasLogoDunkel !== 'undefined' && hasLogoDunkel) { %>
          <div class="form-check mt-1">
            <input class="form-check-input" type="checkbox" id="logoDunkelEntfernen" name="logoDunkelEntfernen" value="1">
            <label class="form-check-label" for="logoDunkelEntfernen">Dunkles Logo entfernen</label>
          </div>
        <% } %>
      </div>
      <div class="mb-3">
        <label class="form-label" for="logoAusrichtung">Logo-Ausrichtung</label>
        <select class="form-select" id="logoAusrichtung" name="logoAusrichtung">
          <option value="links" <%= logoAusrichtung === 'links' ? 'selected' : '' %>>Linksbündig</option>
          <option value="mitte" <%= logoAusrichtung === 'mitte' ? 'selected' : '' %>>Mittig</option>
          <option value="rechts" <%= logoAusrichtung === 'rechts' ? 'selected' : '' %>>Rechtsbündig</option>
        </select>
      </div>
      <div class="mb-3">
        <label class="form-label" for="seitenTitel">Seitentitel</label>
        <input type="text" class="form-control" id="seitenTitel" name="seitenTitel" value="<%= seitenTitel %>" maxlength="60" placeholder="Freigabeportal">
        <div class="form-text">Erscheint im Browser-Tab-Titel jeder Seite (z.B. „Aufgaben — &lt;Seitentitel&gt;“). Leer lassen für „Freigabeportal“.</div>
      </div>
      <div class="mb-3">
        <label class="form-label" for="footerText">Footer-Text</label>
        <input type="text" class="form-control" id="footerText" name="footerText" value="<%= footerText %>" maxlength="200" placeholder="z.B. Kirchenname oder Kontakt-Mail">
        <div class="form-text">Wird im Footer als „© <%= new Date().getFullYear() %> …“ angezeigt. Leer lassen für kein Text.</div>
      </div>
      <button type="submit" class="btn btn-primary">Speichern</button>
      <% if (gespeichert) { %>
        <div class="alert alert-success alert-dismissible alert-kompakt fade show d-inline-flex align-items-center py-1 ps-2 ms-2 mb-0" role="alert">
          Gespeichert.
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Schließen"></button>
        </div>
      <% } %>
    </form>
<%- include('../_seite_ende') %>
