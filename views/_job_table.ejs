<% if (jobs.length === 0) { %>
  <p><%= leerText %></p>
<% } else { %>
  <div class="table-responsive">
    <table class="table align-middle">
      <thead><tr><th>Vorschau</th><th>Quelle</th><th>Absender</th><th>Debitor</th><th>Konto</th><th>Eingang</th><th></th></tr></thead>
      <tbody>
        <% jobs.forEach((job) => { %>
          <tr id="<%= idPrefix %>-row-<%= job.id %>">
            <td>
              <% if (job.thumbnail_pfad) { %>
                <img class="thumbnail-preview pdf-preview rounded" src="/api/pool/<%= job.id %>/thumbnail" data-job-id="<%= job.id %>" data-preview-url="<%= job.previewUrl %>" alt="Vorschau" height="60" style="cursor:pointer">
              <% } else { %>
                <span class="thumbnail-placeholder text-muted">Keine Vorschau</span>
              <% } %>
            </td>
            <td><%= job.quelle === 'scanner' ? 'Scanner' : 'Lieferant' %></td>
            <td><%= job.absender || '—' %></td>
            <td><%= job.lieferant || '—' %></td>
            <td><%= job.kontonummer || '—' %></td>
            <td><%= job.eingang_am %></td>
            <td>
              <% if (idPrefix === 'pool') { %>
                <button type="button" class="beanspruchen-btn btn btn-primary btn-sm" data-job-id="<%= job.id %>">Beanspruchen</button>
              <% } else { %>
                <a href="<%= linkPrefix %>/<%= job.id %>" class="btn btn-outline-primary btn-sm"><%= aktionLabel %></a>
                <% if (idPrefix === 'kontierung') { %>
                  <form method="post" action="/kontierung/<%= job.id %>/zurueck-in-pool" class="d-inline">
                    <button type="submit" class="btn btn-outline-secondary btn-sm">In den Pool legen</button>
                  </form>
                <% } %>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>
