<%- include('_seite_anfang', { titel: 'Abgemeldet' }) %>
    <h1>Du wurdest abgemeldet</h1>
    <p class="alert alert-success">Deine Sitzung im Freigabeportal wurde beendet.</p>
    <p><a href="/auth/login" class="btn btn-primary">Erneut anmelden</a></p>
    <% if (churchtoolsBaseUrl) { %>
      <p class="text-muted small">
        Solange du bei ChurchTools selbst noch angemeldet bist, meldet dich "Erneut anmelden" ohne
        erneute Passwortabfrage direkt wieder an (Single Sign-on). Falls du auch die
        ChurchTools-Sitzung in diesem Browser beenden möchtest (z. B. an einem gemeinsam genutzten
        Rechner), kannst du das hier separat tun:<br>
        <a href="<%= churchtoolsBaseUrl %>/?q=logout" target="_blank" rel="noopener noreferrer">Auch bei ChurchTools abmelden</a>
      </p>
    <% } %>
<%- include('_seite_ende') %>
