<% /* Parameter: alleKonten. Das Formular-action setzt die Pool-Seite per data-zurueck-in-pool, die Kontierung rendert es direkt. */ %>
<div class="modal fade" id="zurueck-in-pool-modal" tabindex="-1" aria-labelledby="zurueck-in-pool-modal-label" aria-hidden="true">
  <div class="modal-dialog">
    <form class="modal-content" id="zurueck-in-pool-form" method="post" action="<%= locals.zurueckInPoolAction || '' %>">
      <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
      <div class="modal-header">
        <h5 class="modal-title" id="zurueck-in-pool-modal-label">Zurück in den Pool legen</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Schliessen"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <label class="form-label" for="hinweisKontoId">Für welches Konto ist diese Rechnung vermutlich bestimmt? <span class="text-muted">(optional)</span></label>
          <select class="form-select" id="hinweisKontoId" name="hinweisKontoId" data-searchable>
            <option value="">— kein Hinweis —</option>
            <% (locals.alleKonten || []).forEach((k) => { %>
              <option value="<%= k.id %>"><%= k.kontonummer %> — <%= k.bezeichnung %></option>
            <% }) %>
          </select>
          <div class="form-text">Hilft der zuständigen Person, die Rechnung im Pool zu finden — sie bekommt eine E-Mail.</div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Abbrechen</button>
        <button type="submit" class="btn btn-primary">Zurück in den Pool legen</button>
      </div>
    </form>
  </div>
</div>
