<%- include('_seite_anfang', { titel: 'Rechnung aufsplitten', rahmen: 'ohne' }) %>
    <div class="seitenkopf">
      <h1 class="seitenkopf-titel">Rechnung aufsplitten: <%- include('_beleg_name', { job }) %> <%- include('_beleg_nr', { jobId: job.id }) %></h1>
    </div>
    <p class="text-muted">Vorgangsnummer: <%= job.id %></p>
    <div class="row g-3 beleg-umschalter" data-beleg-umschalter data-refresh-url="/downloads/<%= job.id %>/refresh-url">
      <%# Aufsplitten hatte nie ein eingebettetes PDF: ab 992 px bleibt es so, darunter kommt der Beleg per Umschalter dazu. %>
      <%- include('_beleg_umschalter', { jobId: job.id, pdfUrl: `/downloads/${job.id}/oeffnen`, thumbnailUrl: job.thumbnail_pfad ? `/downloads/${job.id}/thumbnail` : null, refreshUrl: `/downloads/${job.id}/refresh-url`, einbetten: false, spalte: 'col-12 d-lg-none' }) %>
      <div class="col-lg-12 beleg-umschalter-formular" id="beleg-umschalter-formular">
    <% if (errors.length > 0) { %>
      <div class="alert alert-danger">
        <ul class="mb-0"><% errors.forEach((error) => { %><li><%= error %></li><% }) %></ul>
      </div>
    <% } %>
    <p>Jede Zeile wird zu einer eigenständigen Rechnung mit eigenem Konto und Teilbetrag. Zahlungsziel, Lieferant, Absender und Rechnungsnummer werden übernommen. Für Konten, bei denen du Freigeber oder Stellvertretung bist, gilt Freigabe 1 automatisch als durch dich erteilt — ausser du kreuzt "Konflikt" an, dann geht der Teil direkt an deine Stellvertretung. Für andere Konten landet der Teil unzugewiesen im Pool mit einem Hinweis für die zuständige Person. Das Kästchen "Konflikt" ist nur relevant, wenn du bei diesem Konto selbst Freigeber oder Stellvertretung bist.</p>

    <form method="post" action="/kontierung/<%= job.id %>/aufsplitten" enctype="multipart/form-data" class="col-12">
      <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
      <div class="mb-3">
        <span class="form-label d-block">Typ</span>
        <div class="form-check form-check-inline">
          <input class="form-check-input" type="radio" name="typ" id="typRechnung" value="rechnung" <%= typ !== 'gutschrift' ? 'checked' : '' %>>
          <label class="form-check-label" for="typRechnung">Rechnung</label>
        </div>
        <div class="form-check form-check-inline">
          <input class="form-check-input" type="radio" name="typ" id="typGutschrift" value="gutschrift" <%= typ === 'gutschrift' ? 'checked' : '' %>>
          <label class="form-check-label" for="typGutschrift">Gutschrift</label>
        </div>
        <div class="form-text">Gilt für alle Teile gemeinsam.</div>
      </div>
      <div class="mb-3 col-12 col-sm-6 col-md-4">
        <label class="form-label" for="gesamtbetrag">Gesamtbetrag</label>
        <input type="text" inputmode="decimal" class="form-control" id="gesamtbetrag" name="gesamtbetrag" value="<%= gesamtbetrag %>" placeholder="z.B. 200.00" required>
        <div class="form-text">Die Teilbeträge unten müssen exakt diese Summe ergeben.</div>
      </div>
      <div id="teile-container">
        <% teile.forEach((teil) => { %>
          <div class="row g-2 mb-3 pb-3 border-bottom align-items-center teil-zeile">
            <div class="col-12 col-md-6 col-xl-5">
              <label class="d-block mb-0"><span class="zeile-beschriftung">Konto</span>
              <select class="form-select" name="teilKontoId">
                <option value="">— Konto wählen —</option>
                <% alleKonten.forEach((k) => { %>
                  <option value="<%= k.id %>" <%= String(k.id) === teil.kontoId ? 'selected' : '' %>><%= k.kontonummer %> — <%= k.bezeichnung %></option>
                <% }) %>
              </select></label>
            </div>
            <div class="col-6 col-md-3 col-xl-3">
              <label class="d-block mb-0"><span class="zeile-beschriftung">Teilbetrag</span>
              <input type="text" inputmode="decimal" class="form-control" name="teilBetrag" value="<%= teil.betrag %>" placeholder="Teilbetrag, z.B. 61.75"></label>
            </div>
            <div class="col-6 col-md-3 col-xl-2">
              <label class="d-block mb-0"><span class="zeile-beschriftung">Position</span>
              <input type="text" class="form-control" name="teilPosition" value="<%= teil.position || '' %>" placeholder="Position, z.B. Pos. 2"></label>
            </div>
            <div class="col-6 col-xl-1 form-check teil-konflikt">
              <label class="form-check-label"><input type="checkbox" class="form-check-input konflikt-checkbox" <%= teil.interessenskonflikt ? 'checked' : '' %>> <span class="small">Konflikt</span></label>
              <input type="hidden" name="teilInteressenskonflikt" value="<%= teil.interessenskonflikt ? 'true' : 'false' %>">
            </div>
            <div class="col-6 col-xl-1 text-end text-xl-start">
              <button type="button" class="btn btn-outline-danger btn-sm zeile-entfernen">Entfernen</button>
            </div>
            <div class="col-12">
              <label class="form-label small">Beleg für diese Zeile <span class="text-muted">(optional, z.B. Einzelbeleg zu einer Kreditkartenabrechnung — PDF, PNG oder JPEG)</span></label>
              <input type="file" class="form-control form-control-sm teil-beleg-input" accept="application/pdf,image/png,image/jpeg">
            </div>
          </div>
        <% }) %>
      </div>
      <button type="button" id="zeile-hinzufuegen" class="btn btn-outline-secondary btn-sm mb-3">+ Teilbetrag hinzufügen</button>
      <div class="mb-3">
        <label class="form-label" for="begruendung">Begründung <span class="text-muted">(bei mind. einem Interessenskonflikt Pflicht)</span></label>
        <textarea class="form-control" id="begruendung" name="begruendung"><%= begruendung || '' %></textarea>
      </div>
      <div class="d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-primary">Aufsplitten</button>
        <a href="/kontierung/<%= job.id %>" id="abbrechen-link" class="btn btn-outline-secondary">Abbrechen</a>
      </div>
    </form>
      </div>
    </div>
  <script>
    (function () {
      // Reached both standalone (direct navigation) and embedded in an <iframe> inside a Bootstrap
      // modal on kontierung.ejs. Embedded, "Abbrechen" must close the modal, not navigate the
      // iframe to a full standalone page — there's no way to reach the parent's Bootstrap modal
      // API directly (different document), so this posts a message the parent listens for instead.
      if (window.parent !== window) {
        document.getElementById('abbrechen-link').addEventListener('click', function (e) {
          e.preventDefault();
          window.parent.postMessage('aufsplitten-abbrechen', window.location.origin);
        });
      }
    })();
    (function () {
      var kontoOptionsHtml = document.querySelector('.teil-zeile select').innerHTML;
      // The checkbox itself has no `name` and is never submitted — it only drives the hidden
      // input's value via this listener. With several dynamically added/removed rows, a shared
      // `name` on the checkboxes alone can't be parsed back into a reliable 1:1 array alongside
      // teilKontoId/teilBetrag: an unchecked checkbox sends nothing at all, so the submitted
      // array would silently shrink and misalign for any row after the first unchecked one. The
      // always-present hidden input keeps exactly one value per row, same as teilKontoId/teilBetrag.
      function konfliktCheckboxBinden(zeile) {
        var checkbox = zeile.querySelector('.konflikt-checkbox');
        var hidden = zeile.querySelector('input[name="teilInteressenskonflikt"]');
        checkbox.addEventListener('change', function () {
          hidden.value = checkbox.checked ? 'true' : 'false';
        });
      }
      function zeileEntfernenBinden(zeile) {
        zeile.querySelector('.zeile-entfernen').addEventListener('click', function () {
          zeile.remove();
        });
      }
      document.querySelectorAll('.teil-zeile').forEach(function (zeile) {
        zeileEntfernenBinden(zeile);
        konfliktCheckboxBinden(zeile);
      });
      document.getElementById('zeile-hinzufuegen').addEventListener('click', function () {
        var zeile = document.createElement('div');
        zeile.className = 'row g-2 mb-3 pb-3 border-bottom align-items-center teil-zeile';
        zeile.innerHTML =
          '<div class="col-12 col-md-6 col-xl-5"><label class="d-block mb-0"><span class="zeile-beschriftung">Konto</span><select class="form-select" name="teilKontoId">' + kontoOptionsHtml + '</select></label></div>' +
          '<div class="col-6 col-md-3 col-xl-3"><label class="d-block mb-0"><span class="zeile-beschriftung">Teilbetrag</span><input type="text" inputmode="decimal" class="form-control" name="teilBetrag" placeholder="Teilbetrag, z.B. 61.75"></label></div>' +
          '<div class="col-6 col-md-3 col-xl-2"><label class="d-block mb-0"><span class="zeile-beschriftung">Position</span><input type="text" class="form-control" name="teilPosition" placeholder="Position, z.B. Pos. 2"></label></div>' +
          '<div class="col-6 col-xl-1 form-check teil-konflikt"><label class="form-check-label"><input type="checkbox" class="form-check-input konflikt-checkbox"> <span class="small">Konflikt</span></label><input type="hidden" name="teilInteressenskonflikt" value="false"></div>' +
          '<div class="col-6 col-xl-1 text-end text-xl-start"><button type="button" class="btn btn-outline-danger btn-sm zeile-entfernen">Entfernen</button></div>' +
          '<div class="col-12"><label class="form-label small">Beleg für diese Zeile <span class="text-muted">(optional, z.B. Einzelbeleg zu einer Kreditkartenabrechnung — PDF, PNG oder JPEG)</span></label><input type="file" class="form-control form-control-sm teil-beleg-input" accept="application/pdf,image/png,image/jpeg"></div>';
        document.getElementById('teile-container').appendChild(zeile);
        zeileEntfernenBinden(zeile);
        konfliktCheckboxBinden(zeile);
      });
      // Native <input type="file"> fields with nothing selected are simply omitted from the
      // multipart body by the browser — so req.files on the server would not line up
      // positionally with teilKontoId[i]/teilBetrag[i] whenever some rows have a file and others
      // don't. Renaming each row's file input to its current position right before submit (not
      // at row-creation time, so add/remove reordering is always handled correctly) gives the
      // server a stable teilBeleg_<i> fieldname to match back against that row's other fields.
      document.querySelector('form[action$="/aufsplitten"]').addEventListener('submit', function () {
        document.querySelectorAll('.teil-zeile').forEach(function (zeile, i) {
          var fileInput = zeile.querySelector('.teil-beleg-input');
          if (fileInput && fileInput.files.length > 0) {
            fileInput.name = 'teilBeleg_' + i;
          } else if (fileInput) {
            fileInput.removeAttribute('name');
          }
        });
      });
    })();
  </script>
<%- include('_seite_ende', { rahmen: 'ohne' }) %>
