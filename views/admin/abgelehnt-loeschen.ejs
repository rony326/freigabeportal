<%- include('../_seite_anfang', { titel: 'Rechnung löschen' }) %>
    <div class="seitenkopf">
      <h1 class="seitenkopf-titel">Rechnung löschen: <%- include('../_beleg_name', { job }) %> <%- include('../_beleg_nr', { jobId: job.id }) %></h1>
    </div>
    <p class="text-muted">Ablehnungsgrund: <%= job.ablehnungsgrund %></p>
    <% if (errors.length > 0) { %>
      <div class="alert alert-danger">
        <ul class="mb-0"><% errors.forEach((error) => { %><li><%= error %></li><% }) %></ul>
      </div>
    <% } %>
    <div class="alert alert-warning">Diese Aktion löscht die Rechnung inklusive PDF endgültig. Das kann nicht rückgängig gemacht werden.</div>
    <form method="post" action="/admin/abgelehnt/<%= job.id %>/loeschen" class="col-12 col-md-8 col-lg-6">
      <input type="hidden" name="_csrf" value="<%= locals.csrfToken || '' %>">
      <div class="mb-3">
        <label class="form-label" for="begruendung">Begründung für die Löschung</label>
        <textarea class="form-control" id="begruendung" name="begruendung" required><%= begruendung %></textarea>
      </div>
      <div class="mb-3 form-check">
        <input class="form-check-input" type="checkbox" id="bestaetigung" name="bestaetigung" value="ja" required>
        <label class="form-check-label" for="bestaetigung">Ich bestätige, dass diese Rechnung endgültig gelöscht werden soll.</label>
      </div>
      <button type="submit" class="btn btn-danger">Endgültig löschen</button>
      <a href="/admin/abgelehnt" class="btn btn-outline-secondary">Abbrechen</a>
    </form>
<%- include('../_seite_ende') %>
