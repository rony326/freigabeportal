<!DOCTYPE html>
<html lang="de"<% if (branding.themeAttr) { %> data-theme="<%= branding.themeAttr %>" data-bs-theme="<%= branding.bsThemeAttr %>"<% } %>>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="/vendor/bootstrap/bootstrap.min.css">
  <title>Admin — <%= branding.seitenTitel %></title>
</head>
<body>
  <%- include('../_header') %>
  <main class="container py-4">
    <h1>Admin</h1>
    <% if (adminNav.zeitstempel) { %>
      <% if (typeof zeitstempelUeberfaellig !== 'undefined' && zeitstempelUeberfaellig > 0) { %>
        <div class="alert alert-danger">
          <%= zeitstempelUeberfaellig %> abgeschlossene Rechnung<%= zeitstempelUeberfaellig === 1 ? '' : 'en' %> seit über <%= zeitstempelWarnungSchwelle %> Stunde<%= zeitstempelWarnungSchwelle === 1 ? '' : 'n' %> ohne Zeitstempel — <a href="/admin/zeitstempel">TSA-Konfiguration prüfen</a>.
        </div>
      <% } %>
    <% } %>
    <div class="row row-cols-1 row-cols-md-3 g-3">
      <% if (adminNav.konten) { %>
      <div class="col">
        <a href="/admin/konten" class="card text-decoration-none h-100">
          <div class="card-body">
            <h2 class="h5 card-title">Konten</h2>
            <p class="card-text text-body-secondary">Konten und ihre Freigeber verwalten.</p>
          </div>
        </a>
      </div>
      <% } %>
      <% if (adminNav.debitoren) { %>
      <div class="col">
        <a href="/admin/debitoren" class="card text-decoration-none h-100">
          <div class="card-body">
            <h2 class="h5 card-title">Debitoren</h2>
            <p class="card-text text-body-secondary">Debitoren verwalten und Absender-Muster zuordnen.</p>
          </div>
        </a>
      </div>
      <% } %>
      <% if (adminNav.eskalation) { %>
      <div class="col">
        <a href="/admin/eskalation" class="card text-decoration-none h-100">
          <div class="card-body">
            <h2 class="h5 card-title">Eskalationszeiten</h2>
            <p class="card-text text-body-secondary">Reminder- und Eskalationsfristen einstellen.</p>
          </div>
        </a>
      </div>
      <% } %>
      <% if (adminNav.erscheinungsbild) { %>
      <div class="col">
        <a href="/admin/erscheinungsbild" class="card text-decoration-none h-100">
          <div class="card-body">
            <h2 class="h5 card-title">Erscheinungsbild</h2>
            <p class="card-text text-body-secondary">Farben, Logo und Standard-Farbmodus.</p>
          </div>
        </a>
      </div>
      <% } %>
      <% if (adminNav.zeitstempel) { %>
      <div class="col">
        <a href="/admin/zeitstempel" class="card text-decoration-none h-100">
          <div class="card-body">
            <h2 class="h5 card-title">Zeitstempel</h2>
            <p class="card-text text-body-secondary">RFC3161-Zeitstempel-Server (TSA) einstellen.</p>
          </div>
        </a>
      </div>
      <% } %>
      <% if (adminNav.personen) { %>
      <div class="col">
        <a href="/admin/personen" class="card text-decoration-none h-100">
          <div class="card-body">
            <h2 class="h5 card-title">Personen</h2>
            <p class="card-text text-body-secondary">Synchronisierte Personen und ihr Status.</p>
          </div>
        </a>
      </div>
      <% } %>
      <% if (adminNav.mails) { %>
      <div class="col">
        <a href="/admin/mails" class="card text-decoration-none h-100">
          <div class="card-body">
            <h2 class="h5 card-title">Mail-Protokoll</h2>
            <p class="card-text text-body-secondary">Versendete und fehlgeschlagene E-Mails.</p>
          </div>
        </a>
      </div>
      <% } %>
      <% if (adminNav.sync) { %>
      <div class="col">
        <a href="/admin/sync" class="card text-decoration-none h-100">
          <div class="card-body">
            <h2 class="h5 card-title">Sync-Übersicht</h2>
            <p class="card-text text-body-secondary">ChurchTools-Sync-Historie und feststeckende Jobs.</p>
          </div>
        </a>
      </div>
      <% } %>
      <% if (adminNav.geplanteJobs) { %>
      <div class="col">
        <a href="/admin/geplante-jobs" class="card text-decoration-none h-100">
          <div class="card-body">
            <h2 class="h5 card-title">Geplante Jobs</h2>
            <p class="card-text text-body-secondary">Zeitplan der Cron-Jobs einstellen, manuell auslösen, Verlauf einsehen.</p>
          </div>
        </a>
      </div>
      <% } %>
      <% if (adminNav.abgelehnt) { %>
      <div class="col">
        <a href="/admin/abgelehnt" class="card text-decoration-none h-100">
          <div class="card-body">
            <h2 class="h5 card-title">Abgelehnte Rechnungen</h2>
            <p class="card-text text-body-secondary">Endgültig löschen, mit Begründung und Bestätigung.</p>
          </div>
        </a>
      </div>
      <% } %>
    </div>
  </main>
  <%- include('../_footer') %>
</body>
</html>
