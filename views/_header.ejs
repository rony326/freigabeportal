<script>
  // Bootstrap 5.3's own components (e.g. .table) obey ONLY the explicit data-bs-theme attribute —
  // it has no built-in prefers-color-scheme auto-detection. When branding.themeAttr is null (no
  // theme cookie and no admin default — i.e. "system"), <html> carries neither data-theme nor
  // data-bs-theme at all, so Bootstrap silently defaults every component to light regardless of
  // the OS's dark mode, even though this app's own --bg/--fg CSS variables (see _brand_styles)
  // already react correctly via @media (prefers-color-scheme: dark). Runs first, synchronously,
  // before any Bootstrap-styled markup below is parsed, so there is no flash of the wrong theme.
  (function () {
    var root = document.documentElement;
    if (root.hasAttribute('data-bs-theme')) return;
    var dunkel = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
    root.setAttribute('data-theme', dunkel ? 'dunkel' : 'hell');
    root.setAttribute('data-bs-theme', dunkel ? 'dark' : 'light');
  })();
</script>
<script src="/vendor/bootstrap/bootstrap.bundle.min.js"></script>
<link rel="stylesheet" href="/vendor/bootstrap/bootstrap.min.css">
<%- include('_brand_styles') %>
<header class="p-3 border-bottom mb-3" style="display:grid; grid-template-columns: 1fr 1fr 1fr; align-items:center;">
  <div class="text-start">
    <% if (branding.hasLogo && branding.logoAusrichtung === 'links') { %>
      <img src="/branding/logo" alt="Logo" height="48" class="mt-2 mx-2">
    <% } %>
  </div>
  <div class="text-center">
    <% if (branding.hasLogo && branding.logoAusrichtung === 'mitte') { %>
      <img src="/branding/logo" alt="Logo" height="48" class="mt-2 mx-2">
    <% } %>
  </div>
  <div class="d-flex justify-content-end align-items-center gap-2">
    <% if (branding.hasLogo && branding.logoAusrichtung === 'rechts') { %>
      <img src="/branding/logo" alt="Logo" height="48" class="mt-2 mx-2">
    <% } %>
    <% if (typeof currentPerson !== 'undefined' && currentPerson) { %>
      <span class="text-muted small">Angemeldet als <%= currentPerson.vorname %> <%= currentPerson.nachname %></span>
    <% } %>
    <button type="button" id="theme-toggle" class="btn btn-outline-secondary btn-sm" aria-label="Farbmodus umschalten">🌓</button>
    <% if (typeof currentPerson !== 'undefined' && currentPerson) { %>
      <form method="post" action="/auth/logout" class="d-inline">
        <button type="submit" class="btn btn-outline-secondary btn-sm">Abmelden</button>
      </form>
    <% } %>
  </div>
</header>
<% const navIsPortalAdmin = typeof isPortalAdmin !== 'undefined' && isPortalAdmin; %>
<% const navEingeloggt = typeof currentPerson !== 'undefined' && Boolean(currentPerson); %>
<% const navAktuellerPfad = typeof currentPath !== 'undefined' ? currentPath : ''; %>
<% const navZeigeZurueck = navAktuellerPfad.startsWith('/kontierung'); %>
<% if (navEingeloggt || navZeigeZurueck) { %>
  <nav class="<%= typeof navContainerClass !== 'undefined' ? navContainerClass : 'container' %> mb-3 d-flex align-items-center gap-2">
    <% if (navEingeloggt) { %>
      <div class="dropdown">
        <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" id="hauptmenue-toggle" data-bs-toggle="dropdown" aria-expanded="false">
          Menü
        </button>
        <ul class="dropdown-menu" aria-labelledby="hauptmenue-toggle">
          <li><a class="dropdown-item<%= navAktuellerPfad === '/pool' ? ' active' : '' %>" href="/pool">Aufgaben</a></li>
          <li><a class="dropdown-item<%= navAktuellerPfad === '/zeitstempel-pruefen' ? ' active' : '' %>" href="/zeitstempel-pruefen">Zeitstempel prüfen</a></li>
          <% if (navIsPortalAdmin) { %>
            <li><a class="dropdown-item<%= navAktuellerPfad.startsWith('/admin') ? ' active' : '' %>" href="/admin">Admin</a></li>
          <% } %>
        </ul>
      </div>
    <% } %>
    <% if (navZeigeZurueck) { %>
      <a href="/pool" class="btn btn-primary btn-sm">← Zurück</a>
    <% } %>
    <% if (navAktuellerPfad === '/pool') { %>
      <a href="/pool" class="btn btn-outline-secondary btn-sm" aria-label="Dashboard neu laden">🔄 Neu laden</a>
    <% } %>
  </nav>
<% } %>
<script>
  document.getElementById('theme-toggle').addEventListener('click', function () {
    var root = document.documentElement;
    var next = root.getAttribute('data-theme') === 'dunkel' ? 'hell' : 'dunkel';
    root.setAttribute('data-theme', next);
    root.setAttribute('data-bs-theme', next === 'dunkel' ? 'dark' : 'light');
    document.cookie = 'theme=' + next + ';path=/;max-age=31536000;samesite=lax';
  });
</script>
