<% if (jobs.length === 0) { %>
  <p>Keine abgeschlossenen Rechnungen.</p>
<% } else { %>
  <div class="table-responsive">
    <table class="table align-middle">
      <thead><tr><th>Dateiname</th><th>Status</th><th>Zeitstempel</th><th></th></tr></thead>
      <tbody>
        <% jobs.forEach((job) => { %>
          <tr id="abgeschlossen-row-<%= job.id %>">
            <td><%= job.dateiname %> <%- include('_kommentar_marke', { jobId: job.id }) %></td>
            <td><%= job.status %></td>
            <td>
              <% if (job.zeitstempel_gesetzt_am) { %>
                ✓ gesetzt am <%= job.zeitstempel_gesetzt_am %>
              <% } else { %>
                <%= locals.testmodus ? 'im Testmodus übersprungen' : 'ausstehend' %>
              <% } %>
            </td>
            <td><%- include('_zeitstempel_aktion', { job }) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>
