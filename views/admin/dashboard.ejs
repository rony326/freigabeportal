<%- include('../_seite_anfang', { titel: 'Übersicht' }) %>
    <div class="seitenkopf">
      <h1 class="seitenkopf-titel">Admin</h1>
    </div>
    <% if (adminNav.zeitstempel) { %>
      <% if (typeof zeitstempelUeberfaellig !== 'undefined' && zeitstempelUeberfaellig > 0) { %>
        <div class="alert alert-danger">
          <%= zeitstempelUeberfaellig %> abgeschlossene Rechnung<%= zeitstempelUeberfaellig === 1 ? '' : 'en' %> seit über <%= zeitstempelWarnungSchwelle %> Stunde<%= zeitstempelWarnungSchwelle === 1 ? '' : 'n' %> ohne Zeitstempel — <a href="/admin/zeitstempel">TSA-Konfiguration prüfen</a>.
        </div>
      <% } %>
      <% if (typeof auditRevisionEmpfaengerFehlt !== 'undefined' && auditRevisionEmpfaengerFehlt) { %>
        <div class="alert alert-warning">
          Für den Audit-Nachweis ist kein Revisions-Empfänger festgelegt — <a href="/admin/zeitstempel">Empfänger eintragen</a>.
        </div>
      <% } %>
    <% } %>
    <div class="row row-cols-1 row-cols-md-3 g-3">
      <% if (adminNav.vorgaenge) { %>
      <div class="col">
        <a href="/admin/vorgaenge" class="card text-decoration-none h-100">
          <div class="card-body">
            <h2 class="h5 card-title">Laufende Vorgänge</h2>
            <p class="card-text text-body-secondary">Alle offenen Vorgänge, wer zuständig ist und wer Freigabe 2 macht.</p>
          </div>
        </a>
      </div>
      <% } %>
      <% if (adminNav.konten) { %>
      <div class="col">
        <a href="/admin/konten" class="card text-decoration-none h-100">
          <div class="card-body">
            <h2 class="h5 card-title">Konten</h2>
            <p class="card-text text-body-secondary">Konten und ihre Freigeber verwalten.</p>
          </div>
        </a>
      </div>
      <% } %>
      <% if (adminNav.kreditoren) { %>
      <div class="col">
        <a href="/admin/kreditoren" class="card text-decoration-none h-100">
          <div class="card-body">
            <h2 class="h5 card-title">Kreditoren</h2>
            <p class="card-text text-body-secondary">Kreditoren verwalten und Absender-Muster zuordnen.</p>
          </div>
        </a>
      </div>
      <% } %>
      <% if (adminNav.kreditkarten) { %>
      <div class="col">
        <a href="/admin/kreditkarten" class="card text-decoration-none h-100">
          <div class="card-body">
            <h2 class="h5 card-title">Kreditkarten</h2>
            <p class="card-text text-body-secondary">Karten, verantwortliche Personen und wer Belege erfassen darf.</p>
          </div>
        </a>
      </div>
      <% } %>
      <% if (adminNav.eskalation) { %>
      <div class="col">
        <a href="/admin/eskalation" class="card text-decoration-none h-100">
          <div class="card-body">
            <h2 class="h5 card-title">Eskalationszeiten</h2>
            <p class="card-text text-body-secondary">Reminder- und Eskalationsfristen einstellen.</p>
          </div>
        </a>
      </div>
      <% } %>
      <% if (adminNav.erscheinungsbild) { %>
      <div class="col">
        <a href="/admin/erscheinungsbild" class="card text-decoration-none h-100">
          <div class="card-body">
            <h2 class="h5 card-title">Erscheinungsbild</h2>
            <p class="card-text text-body-secondary">Farben, Logo und Standard-Farbmodus.</p>
          </div>
        </a>
      </div>
      <% } %>
      <% if (adminNav.module) { %>
      <div class="col">
        <a href="/admin/module" class="card text-decoration-none h-100">
          <div class="card-body">
            <h2 class="h5 card-title">Module</h2>
            <p class="card-text text-body-secondary">Optionale Bereiche und Einstellungen ein- oder ausschalten.</p>
          </div>
        </a>
      </div>
      <% } %>
      <% if (adminNav.zeitstempel) { %>
      <div class="col">
        <a href="/admin/zeitstempel" class="card text-decoration-none h-100">
          <div class="card-body">
            <h2 class="h5 card-title">Zeitstempel</h2>
            <p class="card-text text-body-secondary">RFC3161-Zeitstempel-Server (TSA) einstellen.</p>
          </div>
        </a>
      </div>
      <% } %>
      <% if (adminNav.personen) { %>
      <div class="col">
        <a href="/admin/personen" class="card text-decoration-none h-100">
          <div class="card-body">
            <h2 class="h5 card-title">Personen</h2>
            <p class="card-text text-body-secondary">Synchronisierte Personen und ihr Status.</p>
          </div>
        </a>
      </div>
      <% } %>
      <% if (adminNav.mails) { %>
      <div class="col">
        <a href="/admin/mails" class="card text-decoration-none h-100">
          <div class="card-body">
            <h2 class="h5 card-title">Mail-Protokoll</h2>
            <p class="card-text text-body-secondary">Versendete und fehlgeschlagene E-Mails.</p>
          </div>
        </a>
      </div>
      <% } %>
      <% if (adminNav.mailEinstellungen) { %>
      <div class="col">
        <a href="/admin/mail-einstellungen" class="card text-decoration-none h-100">
          <div class="card-body">
            <h2 class="h5 card-title">Mail-Einstellungen</h2>
            <p class="card-text text-body-secondary">Mail-Vorlagen bearbeiten und Versand-Batching einstellen.</p>
          </div>
        </a>
      </div>
      <% } %>
      <% if (adminNav.sync) { %>
      <div class="col">
        <a href="/admin/sync" class="card text-decoration-none h-100">
          <div class="card-body">
            <h2 class="h5 card-title">Sync-Übersicht</h2>
            <p class="card-text text-body-secondary">ChurchTools-Sync-Historie und feststeckende Jobs.</p>
          </div>
        </a>
      </div>
      <% } %>
      <% if (adminNav.geplanteJobs) { %>
      <div class="col">
        <a href="/admin/geplante-jobs" class="card text-decoration-none h-100">
          <div class="card-body">
            <h2 class="h5 card-title">Geplante Jobs</h2>
            <p class="card-text text-body-secondary">Zeitplan der Cron-Jobs einstellen, manuell auslösen, Verlauf einsehen.</p>
          </div>
        </a>
      </div>
      <% } %>
      <% if (adminNav.abgelehnt) { %>
      <div class="col">
        <a href="/admin/abgelehnt" class="card text-decoration-none h-100">
          <div class="card-body">
            <h2 class="h5 card-title">Abgelehnte Rechnungen</h2>
            <p class="card-text text-body-secondary">Endgültig löschen, mit Begründung und Bestätigung.</p>
          </div>
        </a>
      </div>
      <% } %>
      <% if (adminNav.altfaelle) { %>
      <div class="col">
        <a href="/admin/altfaelle" class="card text-decoration-none h-100">
          <div class="card-body">
            <h2 class="h5 card-title">Altfälle</h2>
            <p class="card-text text-body-secondary">Belege ohne Freigabe- oder Zahlungsnachweis prüfen und für die Übergabe entscheiden.</p>
          </div>
        </a>
      </div>
      <% } %>
      <% if (adminNav.auditLog) { %>
      <div class="col">
        <a href="/admin/audit-log" class="card text-decoration-none h-100">
          <div class="card-body">
            <h2 class="h5 card-title">Audit-Log</h2>
            <p class="card-text text-body-secondary">Durchsuchbare Gesamtsicht über Freigaben und Löschungen.</p>
          </div>
        </a>
      </div>
      <% } %>
      <% if (adminNav.betrieb) { %>
      <div class="col">
        <a href="/admin/betrieb" class="card text-decoration-none h-100">
          <div class="card-body">
            <h2 class="h5 card-title">Betrieb &amp; Nutzung</h2>
            <p class="card-text text-body-secondary">Nutzung, Fehler, Fehlermeldungen, Banner und Datenschutzhinweis.</p>
            <% if (typeof betriebStatus !== 'undefined' && betriebStatus) { %>
              <p class="card-text mb-0"><span class="badge <%= betriebStatus === 'ok' ? 'text-bg-success' : betriebStatus === 'warnung' ? 'text-bg-warning' : 'text-bg-danger' %>">Status: <%= betriebStatus === 'ok' ? 'in Ordnung' : betriebStatus === 'warnung' ? 'Warnung' : 'Fehler' %></span></p>
            <% } %>
          </div>
        </a>
      </div>
      <% } %>
      <% if (adminNav.backup) { %>
      <div class="col">
        <a href="/admin/backup" class="card text-decoration-none h-100">
          <div class="card-body">
            <h2 class="h5 card-title">Datenbank-Backup</h2>
            <p class="card-text text-body-secondary">Sicherung erstellen, Backups verwalten, wiederherstellen.</p>
          </div>
        </a>
      </div>
      <% } %>
    </div>
<%- include('../_seite_ende') %>
