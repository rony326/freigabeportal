<%- include('_seite_anfang', { titel: 'Auswertung' }) %>
<%
  const prozent = (anteil) => `${Math.round(anteil * 100)} %`;
  const breite = (wert, basis) => (basis > 0 ? Math.max(0, Math.min(100, (wert / basis) * 100)).toFixed(1) : '0');
  const zeitraumText = { jahr: 'Laufendes Jahr bis heute', '12m': 'Letzte 12 Monate', vorjahr: `Jahr ${aktuellesJahr - 1}`, eigen: 'Eigener Zeitraum' };
  const datum = (iso) => iso.split('-').reverse().join('.');
  const exportLink = (abschnitt) => `/auswertung/export/${abschnitt}.csv${exportQuery ? `?${exportQuery}` : ''}`;
%>
    <div class="seitenkopf">
      <h1 class="seitenkopf-titel">Auswertung Rechnungen</h1>
    </div>
    <p class="text-body-secondary mb-2"><%= zugang.alle ? 'Alle Konten' : `Deine Konten: ${konten.map((k) => k.kontonummer).join(', ')}` %> · <%= datum(zeitraum.von) %> bis <%= datum(zeitraum.bis) %></p>
    <% if (zeitraum.fehler) { %><div class="alert alert-warning" role="alert"><%= zeitraum.fehler %> Angezeigt wird der Standard-Zeitraum.</div><% } %>
    <form method="get" action="/auswertung" class="filterzeile mb-4">
      <div class="col-auto">
        <label class="form-label small mb-1" for="zeitraum">Zeitraum</label>
        <select class="form-select" id="zeitraum" name="zeitraum">
          <% ['jahr', '12m', 'vorjahr', 'eigen'].forEach((art) => { %>
            <option value="<%= art %>"<%= zeitraum.art === art ? ' selected' : '' %>><%= zeitraumText[art] %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-auto">
        <label class="form-label small mb-1" for="von">Von</label>
        <input type="date" class="form-control" id="von" name="von" value="<%= zeitraum.von %>">
      </div>
      <div class="col-auto">
        <label class="form-label small mb-1" for="bis">Bis</label>
        <input type="date" class="form-control" id="bis" name="bis" value="<%= zeitraum.bis %>">
      </div>
      <div class="col-auto">
        <label class="form-label small mb-1" for="konto">Konto</label>
        <select class="form-select" id="konto" name="konto">
          <option value=""><%= zugang.alle ? 'Alle Konten' : 'Alle meine Konten' %></option>
          <% konten.forEach((k) => { %>
            <option value="<%= k.kontonummer %>"<%= kontoNr === k.kontonummer ? ' selected' : '' %>><%= k.kontonummer %> <%= k.bezeichnung %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-auto align-self-end"><button type="submit" class="btn btn-outline-primary">Anzeigen</button></div>
    </form>
    <p class="form-text mt-n3 mb-4">Von/Bis gilt nur bei «Eigener Zeitraum».</p>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3 mb-4">
      <div class="col"><div class="card h-100"><div class="card-body">
        <div class="text-body-secondary small">Freigegeben</div>
        <div class="fs-4 fw-semibold" data-kennzahl="freigegeben"><%= formatChf(kennzahlen.freigegeben.betrag) %></div>
        <div class="text-body-secondary small"><%= kennzahlen.freigegeben.anzahl %> <%= kennzahlen.freigegeben.anzahl === 1 ? 'Rechnung' : 'Rechnungen' %></div>
      </div></div></div>
      <div class="col"><div class="card h-100"><div class="card-body">
        <div class="text-body-secondary small">Zurzeit in Freigabe</div>
        <div class="fs-4 fw-semibold" data-kennzahl="inFreigabe"><%= formatChf(kennzahlen.inFreigabe.betrag) %></div>
        <div class="text-body-secondary small"><%= kennzahlen.inFreigabe.anzahl %> <%= kennzahlen.inFreigabe.anzahl === 1 ? 'Rechnung' : 'Rechnungen' %></div>
      </div></div></div>
      <div class="col"><div class="card h-100"><div class="card-body">
        <div class="text-body-secondary small">Durchlaufzeit (Median)</div>
        <div class="fs-4 fw-semibold" data-kennzahl="median"><%= formatTage(kennzahlen.medianTage) %></div>
        <div class="text-body-secondary small">Eingang bis Freigabe 2</div>
      </div></div></div>
      <div class="col"><div class="card h-100"><div class="card-body">
        <div class="text-body-secondary small">Länger als <%= schwelleTage %> Tage offen</div>
        <div class="fs-4 fw-semibold<%= kennzahlen.langeOffen.anzahl ? ' text-warning-emphasis' : '' %>" data-kennzahl="langeOffen"><%= kennzahlen.langeOffen.anzahl %></div>
        <div class="text-body-secondary small"><%= kennzahlen.langeOffen.aeltesteTage === null ? 'keine' : `älteste seit ${formatTage(kennzahlen.langeOffen.aeltesteTage)}` %></div>
      </div></div></div>
    </div>

    <section class="card mb-4" aria-labelledby="titelBudget"><div class="card-body">
      <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2 mb-2">
        <h2 class="h5 mb-0" id="titelBudget">Budget pro Konto <span class="text-body-secondary fw-normal">(<%= zeitraum.budgetJahr %>)</span></h2>
        <div class="d-flex flex-wrap gap-3 small align-items-center">
          <span class="d-inline-flex align-items-center gap-1"><span class="auswertung-legende auswertung-frei"></span>freigegeben</span>
          <span class="d-inline-flex align-items-center gap-1"><span class="auswertung-legende auswertung-offen"></span>in Freigabe</span>
          <% if (darfBudgetsPflegen) { %><a href="/admin/budgets?jahr=<%= zeitraum.budgetJahr %>">Budgets bearbeiten</a><% } %>
          <a href="<%= exportLink('budget') %>">CSV exportieren</a>
        </div>
      </div>
      <% if (zeitraum.von.slice(0, 4) !== zeitraum.bis.slice(0, 4)) { %>
        <p class="small text-body-secondary">Der Zeitraum umfasst mehrere Jahre. Dieser Abschnitt zeigt das Budget-Jahr <%= zeitraum.budgetJahr %> und nur die darin freigegebenen Rechnungen.</p>
      <% } %>
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead><tr><th>Konto</th><th>Budgetverantwortlich</th><th class="text-end">Budget</th><th class="text-end">Freigegeben</th><th class="text-end">In Freigabe</th><th style="min-width: 14rem">Ausschöpfung</th></tr></thead>
          <tbody>
            <% budget.forEach((z) => { %>
              <tr>
                <td class="fw-medium"><%= z.kontonummer %> <%= z.bezeichnung %></td>
                <td><%= z.verantwortlich || '—' %></td>
                <td class="text-end"><%= z.budget === null ? 'kein Budget' : formatChf(z.budget) %></td>
                <td class="text-end"><%= formatChf(z.freigegeben) %></td>
                <td class="text-end"><%= formatChf(z.inFreigabe) %></td>
                <td>
                  <% if (z.budget === null) { %>
                    <span class="text-body-secondary small">—</span>
                  <% } else { %>
                    <div class="d-flex align-items-center gap-2">
                      <div class="auswertung-balken flex-grow-1" role="img" aria-label="<%= prozent(z.ausschoepfung) %> des Budgets">
                        <span class="auswertung-frei" style="width: <%= breite(z.freigegeben, z.budget) %>%"></span><span class="<%= z.ueberBudget ? 'auswertung-ueber' : 'auswertung-offen' %>" style="width: <%= breite(z.inFreigabe, z.budget) %>%"></span>
                      </div>
                      <span class="small fw-semibold text-end<%= z.ueberBudget ? ' text-warning-emphasis' : '' %>" style="min-width: 6.5rem"><%= prozent(z.ausschoepfung) %><%= z.ueberBudget ? ' · über Budget' : '' %></span>
                    </div>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div></section>

    <div class="row g-4 mb-4">
      <div class="<%= engpaesse ? 'col-xl-6' : 'col-12' %>">
        <section class="card h-100" aria-labelledby="titelDurchlauf"><div class="card-body">
          <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2">
            <h2 class="h5 mb-0" id="titelDurchlauf">Durchlaufzeit pro Stufe</h2>
            <a class="small" href="<%= exportLink('durchlauf') %>">CSV exportieren</a>
          </div>
          <p class="small text-body-secondary">Kalendertage, im Zeitraum freigegebene Rechnungen.</p>
          <div class="table-responsive">
          <table class="table mb-0">
            <thead><tr><th>Stufe</th><th class="text-end">Median</th><th class="text-end">Langsamste 10 %</th><th class="text-end">Rechnungen</th></tr></thead>
            <tbody>
              <% durchlauf.forEach((s) => { %>
                <tr><td><%= stufenLabel[s.stufe] %></td><td class="text-end"><%= formatTage(s.median) %></td><td class="text-end"><%= formatTage(s.p90) %></td><td class="text-end"><%= s.anzahl %></td></tr>
              <% }) %>
            </tbody>
          </table>
          </div>
        </div></section>
      </div>
      <% if (engpaesse) { %>
      <div class="col-xl-6">
        <section class="card h-100" aria-labelledby="titelEngpaesse"><div class="card-body">
          <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2">
            <h2 class="h5 mb-0" id="titelEngpaesse">Wo Rechnungen liegen</h2>
            <a class="small" href="<%= exportLink('engpaesse') %>">CSV exportieren</a>
          </div>
          <p class="small text-body-secondary">Offene Rechnungen pro zuständiger Person, älteste zuerst. Alter seit Eintritt in die aktuelle Stufe.</p>
          <% if (engpaesse.length === 0) { %>
            <p class="text-body-secondary mb-0">Zurzeit liegen keine Rechnungen offen.</p>
          <% } else { %>
          <div class="table-responsive">
          <table class="table mb-0">
            <thead><tr><th>Zuständig</th><th>Stufe</th><th class="text-end">Offen</th><th class="text-end">Älteste</th></tr></thead>
            <tbody>
              <% engpaesse.forEach((e) => { %>
                <tr>
                  <td class="fw-medium"><% if (darfVorgaenge && e.art === 'person' && e.personId) { %><a href="/admin/vorgaenge?person=<%= encodeURIComponent(e.personId) %>"><%= e.name %></a><% } else { %><%= e.name %><% } %></td>
                  <td><%= e.stufe %></td>
                  <td class="text-end"><%= e.anzahl %></td>
                  <td class="text-end fw-semibold<%= e.aeltesteTage > schwelleTage ? ' text-warning-emphasis' : '' %>"><%= formatTage(e.aeltesteTage) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
          </div>
          <% } %>
        </div></section>
      </div>
      <% } %>
    </div>

    <section class="card mb-4" aria-labelledby="titelLieferanten"><div class="card-body">
      <div class="d-flex flex-wrap justify-content-between align-items-baseline gap-2 mb-2">
        <h2 class="h5 mb-0" id="titelLieferanten">Lieferanten</h2>
        <span class="small"><span class="text-body-secondary">nach Betrag im Zeitraum</span> · <a href="<%= exportLink('lieferanten') %>">CSV exportieren</a></span>
      </div>
      <% if (lieferanten.length === 0) { %>
        <p class="text-body-secondary mb-0">Im Zeitraum wurden keine Rechnungen freigegeben.</p>
      <% } else { %>
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead><tr><th>Lieferant</th><th class="text-end">Rechnungen</th><th class="text-end">Betrag</th><th style="min-width: 12rem">Anteil</th><th>Häufigste Konten</th></tr></thead>
          <tbody>
            <% const groesster = Math.max(...lieferanten.map((l) => l.betrag), 0); %>
            <% lieferanten.forEach((l) => { %>
              <tr>
                <td class="fw-medium"><%= l.name %></td>
                <td class="text-end"><%= l.anzahl %></td>
                <td class="text-end"><%= formatChf(l.betrag) %></td>
                <td><div class="d-flex align-items-center gap-2"><div class="auswertung-balken flex-grow-1" aria-hidden="true"><span class="auswertung-frei" style="width: <%= breite(l.betrag, groesster) %>%"></span></div><span class="small text-end" style="min-width: 3rem"><%= (l.anteil * 100).toFixed(1) %> %</span></div></td>
                <td><%= l.konten.join(', ') || '—' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div></section>

    <section class="small text-body-secondary" aria-labelledby="titelZaehlregeln">
      <h2 class="h5" id="titelZaehlregeln">So wird gezählt</h2>
      <ul>
        <li>«Freigegeben», Budget und Lieferanten beziehen sich auf das Datum der Freigabe 2 (Zürcher Zeit). «In Freigabe» ist immer der aktuelle Stand.</li>
        <li>Gutschriften werden abgezogen. Abgelehnte und gelöschte Rechnungen sowie Rapporte zählen nicht. Spesen zählen mit.</li>
        <li>Aufgesplittete Rechnungen und Kreditkarten-Abrechnungen zählen mit ihren Teilen, je auf dem Konto des Teils.</li>
        <li>Die Ausschöpfung rechnet freigegebene und zurzeit in Freigabe stehende Rechnungen zusammen.</li>
        <li>«Zurzeit in Freigabe» und «länger offen» enthalten auch Belege im Pool (noch ohne Konto); in der Budget-Tabelle fehlen sie.</li>
        <% if (kennzahlen.inEur) { %><li>Enthält <%= kennzahlen.inEur %> <%= kennzahlen.inEur === 1 ? 'Rechnung' : 'Rechnungen' %> in EUR, nicht umgerechnet.</li><% } %>
        <% if (kennzahlen.ohneBetrag) { %><li><%= kennzahlen.ohneBetrag %> <%= kennzahlen.ohneBetrag === 1 ? 'Rechnung hat' : 'Rechnungen haben' %> keinen erfassten Betrag und <%= kennzahlen.ohneBetrag === 1 ? 'zählt' : 'zählen' %> mit CHF 0.</li><% } %>
        <% if (!zugang.alle) { %><li>Du siehst nur die Konten, bei denen du Freigeber 1 oder Stellvertretung bist.</li><% } %>
      </ul>
    </section>
<%- include('_seite_ende') %>
