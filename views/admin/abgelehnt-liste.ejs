<%- include('../_seite_anfang', { titel: 'Abgelehnte Rechnungen' }) %>
<% /* Ansichtswahl (src/middleware/ansicht.js): 'tabelle', 'kacheln' oder 'auto' (Kacheln unter lg, sonst Tabelle). */
   const gewaehlteAnsicht = (typeof ansicht !== 'undefined' && ansicht) || 'auto';
   const zeigeTabelle = gewaehlteAnsicht !== 'kacheln';
   const zeigeKacheln = gewaehlteAnsicht !== 'tabelle';
   const klasseTabelle = 'ansicht-tabelle' + (gewaehlteAnsicht === 'auto' ? ' d-none d-lg-block' : '');
   const klasseKacheln = 'ansicht-kacheln' + (gewaehlteAnsicht === 'auto' ? ' d-lg-none' : ''); %>
    <div class="seitenkopf">
      <h1 class="seitenkopf-titel">Abgelehnte Rechnungen</h1>
      <div class="seitenkopf-aktionen"><%- include('../_ansicht_umschalter') %></div>
    </div>
    <% if (gespeichert) { %>
      <div class="alert alert-success alert-dismissible fade show" role="alert">
        Gelöscht.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Schließen"></button>
      </div>
    <% } %>
    <% if (jobs.length === 0) { %>
      <p>Keine abgelehnten Rechnungen.</p>
    <% } else { %>
      <% if (zeigeTabelle) { %><div class="<%= klasseTabelle %>">
      <div class="table-responsive">
        <table class="table align-middle">
          <thead><tr><th>Dateiname</th><th>Lieferant</th><th>Grund</th><th>Abgelehnt von</th><th>Eingang</th><th></th></tr></thead>
          <tbody>
            <% jobs.forEach((job) => { %>
              <tr>
                <td><%= job.dateiname %></td>
                <td><%= job.lieferant || '—' %></td>
                <td><%= job.ablehnungsgrund %></td>
                <td><%= job.abgelehntVonPerson ? `${job.abgelehntVonPerson.vorname} ${job.abgelehntVonPerson.nachname}` : 'Unbekannt' %></td>
                <td><%= job.eingang_am %></td>
                <td><a href="/admin/abgelehnt/<%= job.id %>" class="btn btn-outline-danger btn-sm">Löschen</a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      </div><% } %>
      <% if (zeigeKacheln) { %><div class="<%= klasseKacheln %>"><%- include('_abgelehnt_kacheln', { jobs }) %></div><% } %>
    <% } %>
<%- include('../_seite_ende') %>
