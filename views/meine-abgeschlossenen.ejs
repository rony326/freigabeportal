<%- include('_seite_anfang', { titel: 'Meine abgeschlossenen Rechnungen' }) %>
<% /* Ansichtswahl (src/middleware/ansicht.js): 'tabelle', 'kacheln' oder 'auto' (Kacheln unter lg, sonst Tabelle). */
   const gewaehlteAnsicht = (typeof ansicht !== 'undefined' && ansicht) || 'auto';
   const zeigeTabelle = gewaehlteAnsicht !== 'kacheln';
   const zeigeKacheln = gewaehlteAnsicht !== 'tabelle';
   const klasseTabelle = 'ansicht-tabelle' + (gewaehlteAnsicht === 'auto' ? ' d-none d-lg-block' : '');
   const klasseKacheln = 'ansicht-kacheln' + (gewaehlteAnsicht === 'auto' ? ' d-lg-none' : ''); %>
    <div class="seitenkopf">
      <h1 class="seitenkopf-titel">Meine abgeschlossenen Rechnungen</h1>
      <div class="seitenkopf-aktionen"><%- include('_ansicht_umschalter') %></div>
    </div>

    <% if (jobs.length === 0) { %>
      <p>Keine abgeschlossenen Rechnungen.</p>
    <% } else { %>
      <p class="text-muted"><%= gesamtAnzahl %> Rechnungen</p>
      <% if (zeigeTabelle) { %><div class="<%= klasseTabelle %>"><%- include('_abgeschlossen_table', { jobs }) %></div><% } %>
      <% if (zeigeKacheln) { %><div class="<%= klasseKacheln %>"><%- include('_abgeschlossen_kacheln', { jobs }) %></div><% } %>

      <nav aria-label="Seiten">
        <ul class="pagination">
          <li class="page-item <%= seite <= 1 ? 'disabled' : '' %>">
            <% if (seite <= 1) { %>
              <span class="page-link">Zurück</span>
            <% } else { %>
              <a class="page-link" href="?seite=<%= seite - 1 %>">Zurück</a>
            <% } %>
          </li>
          <li class="page-item disabled"><span class="page-link">Seite <%= seite %> von <%= gesamtSeiten %></span></li>
          <li class="page-item <%= seite >= gesamtSeiten ? 'disabled' : '' %>">
            <% if (seite >= gesamtSeiten) { %>
              <span class="page-link">Weiter</span>
            <% } else { %>
              <a class="page-link" href="?seite=<%= seite + 1 %>">Weiter</a>
            <% } %>
          </li>
        </ul>
      </nav>
    <% } %>
<%- include('_seite_ende') %>
