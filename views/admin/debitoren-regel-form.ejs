<!DOCTYPE html>
<html lang="de"<% if (branding.themeAttr) { %> data-theme="<%= branding.themeAttr %>" data-bs-theme="<%= branding.bsThemeAttr %>"<% } %>>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="/vendor/bootstrap/bootstrap.min.css">
  <title>Zuweisungsregel — <%= branding.seitenTitel %> Admin</title>
</head>
<body>
  <%- include('../_header') %>
  <main class="container py-4">
    <%- include('./_nav') %>
    <h1>Zuweisungsregel bearbeiten</h1>
    <% if (errors.length > 0) { %>
      <div class="alert alert-danger">
        <ul class="mb-0"><% errors.forEach((error) => { %><li><%= error %></li><% }) %></ul>
      </div>
    <% } %>
    <form method="post" action="/admin/debitoren/regeln/<%= regel.id %>" class="col-12 col-md-8 col-lg-6">
      <div class="mb-3">
        <label class="form-label" for="absenderMuster">Absender-Muster (volle E-Mail-Adresse oder Domain)</label>
        <input type="text" class="form-control" id="absenderMuster" name="absenderMuster" value="<%= values.absenderMuster || '' %>" required>
      </div>
      <div class="mb-3">
        <label class="form-label" for="debitorId">Debitor</label>
        <select class="form-select" id="debitorId" name="debitorId" required>
          <option value="">— wählen —</option>
          <% debitoren.forEach((d) => { %>
            <option value="<%= d.id %>" <%= String(values.debitorId) === String(d.id) ? 'selected' : '' %>><%= d.name %></option>
          <% }) %>
        </select>
      </div>
      <button type="submit" class="btn btn-primary">Speichern</button>
      <a href="/admin/debitoren" class="btn btn-outline-secondary">Abbrechen</a>
    </form>
  </main>
  <%- include('../_footer') %>
</body>
</html>
