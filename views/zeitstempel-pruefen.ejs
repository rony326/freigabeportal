<!DOCTYPE html>
<html lang="de"<% if (branding.themeAttr) { %> data-theme="<%= branding.themeAttr %>" data-bs-theme="<%= branding.bsThemeAttr %>"<% } %>>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="stylesheet" href="/vendor/bootstrap/bootstrap.min.css">
  <title>Zeitstempel prüfen — <%= branding.seitenTitel %></title>
</head>
<body>
  <%- include('_header') %>
  <main class="container py-4">
    <h1>Zeitstempel prüfen</h1>
    <% if (errors.length > 0) { %>
      <div class="alert alert-danger">
        <ul class="mb-0"><% errors.forEach((error) => { %><li><%= error %></li><% }) %></ul>
      </div>
    <% } %>

    <% if (!ergebnis) { %>
      <p>Lade ein PDF hoch, um zu prüfen, ob es einen gültigen RFC3161-Zeitstempel enthält.</p>
      <form method="post" action="/zeitstempel-pruefen" enctype="multipart/form-data" class="col-12 col-lg-6">
        <div class="mb-3">
          <label class="form-label" for="pdf">PDF-Datei</label>
          <input type="file" class="form-control" id="pdf" name="pdf" accept="application/pdf" required>
        </div>
        <button type="submit" class="btn btn-primary">Prüfen</button>
      </form>
    <% } else { %>
      <% if (job) { %>
        <p><a href="/pool">← Zurück zum Dashboard</a></p>
      <% } %>
      <div class="card col-12 col-lg-6">
        <div class="card-body">
          <% if (!ergebnis.vorhanden) { %>
            <p class="mb-0">⚠️ Kein Zeitstempel in dieser Datei gefunden.</p>
          <% } else if (ergebnis.gueltig) { %>
            <p class="mb-0">✓ Gültiger Zeitstempel vorhanden.</p>
            <p class="text-muted small mb-0">Zeitpunkt: <%= ergebnis.zeitpunkt %><% if (ergebnis.tsaPolicy) { %> · TSA-Policy: <%= ergebnis.tsaPolicy %><% } %></p>
          <% } else { %>
            <p class="mb-0 text-danger">✗ Zeitstempel vorhanden, aber ungültig — die Datei wurde nach dem Zeitstempel verändert.</p>
          <% } %>
        </div>
      </div>
      <% if (!job) { %>
        <p class="mt-3"><a href="/zeitstempel-pruefen">Weitere Datei prüfen</a></p>
      <% } %>
    <% } %>
  </main>
  <%- include('_footer') %>
</body>
</html>
